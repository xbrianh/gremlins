#!/usr/bin/env bash
# Poll CI status for a PR until all checks complete or timeout.
# Usage: gh_wait_ci <artifact_dir> <pr_url> [startup_grace_secs] [poll_timeout] [poll_interval]
#
# Writes into artifact_dir:
#   status          — "passed", "failed", or "skipped"
#   ci_poll_done    — touch file to signal loop completion
#   ci_bail         — bail message if human intervention needed
#   ci_failure.txt  — failure logs for the fix agent
#
# Exit codes:
#   0 — all checks passed or skipped (ci_poll_done written)
#   1 — failures found (ci_poll_done NOT written, status=failed)
#   2 — bail (human intervention required, ci_bail written)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/logging.sh"

artifact_dir="${1:-}"
pr_url="${2:-}"
startup_grace_secs="${3:-60}"
poll_timeout="${4:-1200}"
poll_interval="${5:-30}"

if [ -z "$artifact_dir" ] || [ -z "$pr_url" ]; then
    die "Usage: gh_wait_ci <artifact_dir> <pr_url> [startup_grace_secs] [poll_timeout] [poll_interval]"
fi

status_file="$artifact_dir/status"
done_file="$artifact_dir/ci_poll_done"
bail_file="$artifact_dir/ci_bail"
ci_log="$artifact_dir/ci_failure.txt"

# --- helpers ---

fetch_meta() {
    gh pr view "$pr_url" --json statusCheckRollup,reviewDecision,headRefOid --jq '
(.reviewDecision // ""),
((.statusCheckRollup // []) | length),
(.headRefOid // "")
'
}

all_checks_done() {
    gh pr view "$pr_url" --json statusCheckRollup --jq '
(.statusCheckRollup // []) as $r |
if ($r | length) == 0 then
    false
else
    ([$r[] |
        if .__typename == "StatusContext" then
            select(.state == "EXPECTED" or .state == "PENDING")
        else
            select(.status != "COMPLETED")
        end
    ] | length) == 0
end
'
}

get_failed_count() {
    # Returns "count" on stdout, or "count<newline>json" when count > 0.
    gh pr view "$pr_url" --json statusCheckRollup --jq '
[.statusCheckRollup // [] | .[] |
    if .__typename == "StatusContext" then
        select(.state == "FAILURE" or .state == "ERROR")
    else
        select(.conclusion == "FAILURE" or .conclusion == "ERROR" or .conclusion == "TIMED_OUT" or .conclusion == "CANCELLED")
    end
] as $failed |
$failed | length,
if ($failed | length) > 0 then $failed else empty end
'
}

_FAILED_PRINT_FILTER='[.statusCheckRollup // [] | .[] |
    if .__typename == "StatusContext" then
        select(.state == "FAILURE" or .state == "ERROR")
    else
        select(.conclusion == "FAILURE" or .conclusion == "ERROR" or .conclusion == "TIMED_OUT" or .conclusion == "CANCELLED")
    end
] | .[] |
"\n## Check: \(.name // .context // "unknown")\n" +
(
    (.detailsUrl // .targetUrl // "") as $url |
    if $url | test("actions/runs/[0-9]") then
        "\n(gh run view " + ($url | capture("actions/runs/(?<id>[0-9]+)") | .id) + " --log-failed)\n"
    else
        "(no action run URL; details: " + $url + ")\n"
    end
)
'

_FAILED_RUN_FILTER='[.statusCheckRollup // [] | .[] |
    if .__typename == "StatusContext" then
        select(.state == "FAILURE" or .state == "ERROR")
    else
        select(.conclusion == "FAILURE" or .conclusion == "ERROR" or .conclusion == "TIMED_OUT" or .conclusion == "CANCELLED")
    end
] | .[] |
    (.detailsUrl // .targetUrl // "") |
    capture("actions/runs/(?<id>[0-9]+)") | .id
'

check_bail_review_required() {
    local decision="$1"
    if [ "$decision" = "REVIEW_REQUIRED" ]; then
        printf 'ci-gate: PR blocked by required human review\n' > "$bail_file"
        exit 2
    fi
}

# --- startup / SHA sync ---

fix_head=""
if [ -f "$artifact_dir/fix-head" ]; then
    fix_head=$(cat "$artifact_dir/fix-head")
fi

if [ -z "$fix_head" ]; then
    # Iteration 1: startup grace — wait for any check-runs to appear
    grace_deadline=$(( $(date +%s) + startup_grace_secs ))
    rollup_len=0
    while true; do
        meta=$(fetch_meta)
        decision=$(printf '%s' "$meta" | sed -n '1p')
        rollup_len=$(printf '%s' "$meta" | sed -n '2p')
        check_bail_review_required "$decision"
        if [ "$rollup_len" -gt 0 ] || [ "$(date +%s)" -ge "$grace_deadline" ]; then
            break
        fi
        sleep "$poll_interval"
    done
    if [ "$rollup_len" -eq 0 ]; then
        info "ci-gate: no check-runs after ${startup_grace_secs}s grace; skipping"
        printf 'skipped' > "$status_file"
        printf 'passed' > "$done_file"
        exit 0
    fi
else
    # Post-fix: wait for GitHub to reflect the pushed commit SHA
    push_deadline=$(( $(date +%s) + poll_timeout ))
    while true; do
        meta=$(fetch_meta)
        decision=$(printf '%s' "$meta" | sed -n '1p')
        head_oid=$(printf '%s' "$meta" | sed -n '3p')
        check_bail_review_required "$decision"
        if [ "$head_oid" = "$fix_head" ] || git merge-base --is-ancestor "$fix_head" "$head_oid" 2>/dev/null; then
            break
        fi
        if [ "$(date +%s)" -ge "$push_deadline" ]; then
            printf 'ci-gate: timed out waiting for GitHub to reflect pushed SHA\n' > "$bail_file"
            exit 2
        fi
        sleep "$poll_interval"
    done
fi

# --- poll ---

poll_deadline=$(( $(date +%s) + poll_timeout ))
all_done_result="false"
while true; do
    all_done_result=$(all_checks_done)
    meta=$(fetch_meta)
    decision=$(printf '%s' "$meta" | sed -n '1p')
    check_bail_review_required "$decision"
    if [ "$all_done_result" = "true" ]; then break; fi
    if [ "$(date +%s)" -ge "$poll_deadline" ]; then
        warn "ci-gate: poll timed out after ${poll_timeout}s"
        break
    fi
    sleep "$poll_interval"
done

if [ "$all_done_result" != "true" ]; then
    printf 'ci-gate: checks incomplete after timeout\n' > "$bail_file"
    exit 2
fi

# --- result ---

failed_output=$(get_failed_count)
failed_count=$(printf '%s' "$failed_output" | head -1)

if [ "$failed_count" -eq 0 ]; then
    info "ci-gate: all checks passed"
    printf 'passed' > "$status_file"
    printf 'passed' > "$done_file"
    exit 0
fi

# --- failure logs ---

printf 'failed' > "$status_file"
{
    gh pr view "$pr_url" --json statusCheckRollup --jq "$_FAILED_PRINT_FILTER"
    gh pr view "$pr_url" --json statusCheckRollup --jq "$_FAILED_RUN_FILTER" | while IFS= read -r run_id; do
        echo
        echo "--- run $run_id logs ---"
        timeout 30 gh run view "$run_id" --log-failed 2>/dev/null | head -c 10000 \
            || printf '(could not fetch run logs)\n'
        echo "---"
    done
} > "$ci_log" 2>&1
exit 1