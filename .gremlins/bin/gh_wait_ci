#!/usr/bin/env bash
# Poll CI status for a PR until all checks complete or timeout.
# Usage: gh_wait_ci <artifact_dir> <pr_url> [startup_grace_secs] [poll_timeout] [poll_interval]
#
# Writes into artifact_dir:
#   status          — "passed", "failed", or "skipped"
#   ci_poll_done    — touch file to signal loop completion
#   ci_bail         — bail message if human intervention needed
#   ci_failure.txt  — failure logs for the fix agent
#
# Exit codes:
#   0 — all checks passed or skipped (ci_poll_done written)
#   1 — failures found (ci_poll_done NOT written, status=failed)
#   2 — bail (human intervention required, ci_bail written)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/logging.sh"

artifact_dir="${1:-}"
pr_url="${2:-}"
startup_grace_secs="${3:-60}"
poll_timeout="${4:-1200}"
poll_interval="${5:-30}"

if [ -z "$artifact_dir" ] || [ -z "$pr_url" ]; then
    die "Usage: gh_wait_ci <artifact_dir> <pr_url> [startup_grace_secs] [poll_timeout] [poll_interval]"
fi

status_file="$artifact_dir/status"
done_file="$artifact_dir/ci_poll_done"
bail_file="$artifact_dir/ci_bail"
ci_log="$artifact_dir/ci_failure.txt"

# fetch_status: call gh and pipe through python3 for all JSON extraction.
# Prints three lines: review_decision, rollup_length, head_ref_oid
fetch_status() {
    gh pr view "$pr_url" --json statusCheckRollup,reviewDecision,headRefOid | python3 -c "
import sys, json
d = json.load(sys.stdin)
rd = d.get('reviewDecision') or ''
rollup = d.get('statusCheckRollup') or []
oid = d.get('headRefOid') or ''
print(rd)
print(len(rollup))
print(oid)
"
}

# all_checks_done: read rollup JSON from gh, return 'true' or 'false'
all_checks_done() {
    gh pr view "$pr_url" --json statusCheckRollup | python3 -c "
import sys, json
d = json.load(sys.stdin)
rollup = d.get('statusCheckRollup') or []
if len(rollup) == 0:
    print('false')
    sys.exit(0)
for item in rollup:
    if item.get('__typename') == 'StatusContext':
        if item.get('state') in ('EXPECTED', 'PENDING'):
            print('false')
            sys.exit(0)
    else:
        if item.get('status') != 'COMPLETED':
            print('false')
            sys.exit(0)
print('true')
"
}

# get_failed_checks: return JSON array of failed checks
get_failed_checks() {
    gh pr view "$pr_url" --json statusCheckRollup | python3 -c "
import sys, json
d = json.load(sys.stdin)
rollup = d.get('statusCheckRollup') or []
failed = []
for item in rollup:
    if item.get('__typename') == 'StatusContext':
        if item.get('state') in ('FAILURE', 'ERROR'):
            failed.append(item)
    else:
        if item.get('conclusion') in ('FAILURE', 'ERROR', 'TIMED_OUT', 'CANCELLED'):
            failed.append(item)
print(len(failed))
if failed:
    print(json.dumps(failed))
"
}

check_bail_review_required() {
    local decision="$1"
    if [ "$decision" = "REVIEW_REQUIRED" ]; then
        printf 'ci-gate: PR blocked by required human review\n' > "$bail_file"
        exit 2
    fi
}

# Post-fix path: fix-head written by capture-head on prior iteration.
fix_head=""
if [ -f "$artifact_dir/fix-head" ]; then
    fix_head=$(cat "$artifact_dir/fix-head")
fi

# Iteration 1 startup grace: wait for any check-runs to appear.
if [ -z "$fix_head" ]; then
    grace_deadline=$(( $(date +%s) + startup_grace_secs ))
    rollup_len=0
    while true; do
        status_lines=$(fetch_status)
        decision=$(printf '%s' "$status_lines" | sed -n '1p')
        rollup_len=$(printf '%s' "$status_lines" | sed -n '2p')
        check_bail_review_required "$decision"
        if [ "$rollup_len" -gt 0 ] || [ "$(date +%s)" -ge "$grace_deadline" ]; then
            break
        fi
        sleep "$poll_interval"
    done
    if [ "$rollup_len" -eq 0 ]; then
        info "ci-gate: no check-runs after ${startup_grace_secs}s grace; skipping"
        printf 'skipped' > "$status_file"
        printf 'passed' > "$done_file"
        exit 0
    fi
else
    # Post-fix: wait for GitHub to reflect the pushed commit SHA.
    push_deadline=$(( $(date +%s) + poll_timeout ))
    while true; do
        status_lines=$(fetch_status)
        decision=$(printf '%s' "$status_lines" | sed -n '1p')
        head_oid=$(printf '%s' "$status_lines" | sed -n '3p')
        check_bail_review_required "$decision"
        if [ "$head_oid" = "$fix_head" ] || git merge-base --is-ancestor "$fix_head" "$head_oid" 2>/dev/null; then
            break
        fi
        if [ "$(date +%s)" -ge "$push_deadline" ]; then
            printf 'ci-gate: timed out waiting for GitHub to reflect pushed SHA\n' > "$bail_file"
            exit 2
        fi
        sleep "$poll_interval"
    done
fi

# Poll until all checks complete or timeout.
poll_deadline=$(( $(date +%s) + poll_timeout ))
all_done_result="false"
while true; do
    all_done_result=$(all_checks_done)
    status_lines=$(fetch_status)
    decision=$(printf '%s' "$status_lines" | sed -n '1p')
    check_bail_review_required "$decision"
    if [ "$all_done_result" = "true" ]; then break; fi
    if [ "$(date +%s)" -ge "$poll_deadline" ]; then
        warn "ci-gate: poll timed out after ${poll_timeout}s"
        break
    fi
    sleep "$poll_interval"
done

if [ "$all_done_result" != "true" ]; then
    printf 'ci-gate: checks incomplete after timeout\n' > "$bail_file"
    exit 2
fi

# Check for failures.
failed_output=$(get_failed_checks)
failed_count=$(printf '%s' "$failed_output" | head -1)
failed_json_data=$(printf '%s' "$failed_output" | tail -n +2)

if [ "$failed_count" -eq 0 ]; then
    info "ci-gate: all checks passed"
    printf 'passed' > "$status_file"
    printf 'passed' > "$done_file"
    exit 0
fi

# Collect failure logs for the fix agent.
printf 'failed' > "$status_file"
printf '%s' "$failed_json_data" | python3 -c "
import sys, json
failed = json.load(sys.stdin)
for check in failed:
    name = check.get('name') or check.get('context') or 'unknown'
    url = check.get('detailsUrl') or check.get('targetUrl') or ''
    print()
    print(f'## Check: {name}')
    print()
    run_id = ''
    import re
    m = re.search(r'/actions/runs/(\d+)', url)
    if m:
        run_id = m.group(1)
        print(f'(gh run view {run_id} --log-failed)')
    else:
        print(f'(no action run URL; details: {url})')
" > "$ci_log" 2>&1
exit 1