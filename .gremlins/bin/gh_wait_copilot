#!/usr/bin/env bash
# Wait for Copilot review to complete (non-PENDING state).
# Usage: gh_wait_copilot <pr_number> <repo> [max_iterations] [interval_secs]
#
# Polls gh api until Copilot's review is no longer PENDING.
# Outputs the final review state (APPROVED, CHANGES_REQUESTED, etc.) to stdout.
# Exit 0 on completion, 1 on timeout.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/logging.sh"

pr_number="${1:-}"
repo="${2:-}"
max_iterations="${3:-40}"
interval="${4:-20}"

if [ -z "$pr_number" ] || [ -z "$repo" ]; then
    die "Usage: gh_wait_copilot <pr_number> <repo> [max_iterations] [interval_secs]"
fi

iteration=0
while [ "$iteration" -lt "$max_iterations" ]; do
    review=$(gh api "repos/$repo/pulls/$pr_number/reviews" \
        --jq '.[] | select(.user.login | test("[Cc]opilot")) | .state | select(. != "PENDING")' 2>/dev/null || true)

    if [ -n "$review" ]; then
        printf '%s' "$review"
        exit 0
    fi

    iteration=$((iteration + 1))
    if [ "$iteration" -lt "$max_iterations" ]; then
        sleep "$interval"
    fi
done

exit 0
