#!/usr/bin/env bash
# Wait for CI jobs to become available on a PR.
# Usage: gh_ci_await <pr_url> [fix_head] [startup_grace_secs] [poll_interval]
#
# Phases:
#   - No fix_head: startup grace — wait for check-runs to appear AND SHA to sync.
#                  If no checks appear within the grace period, output "skipped".
#                  If checks appear but SHA hasn't synced, keep waiting (bounded
#                  by the exec-stage timeout).
#   - fix_head:    SHA sync — wait for headRefOid to reflect the pushed commit
#                  (bounded by the exec-stage timeout).
#
# Outputs:
#   stdout: "skipped" if no check-runs after grace (exit 0)
#           nothing otherwise (exit 0 when jobs are available)
#   stderr: bail message on REVIEW_REQUIRED (exit 2)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/logging.sh"

pr_url="${1:-}"
fix_head="${2:-}"
startup_grace_secs="${3:-60}"
poll_interval="${4:-30}"

if [ -z "$pr_url" ]; then
    die "Usage: gh_ci_await <pr_url> [fix_head] [startup_grace_secs] [poll_interval]"
fi

# --- helpers ---

fetch_meta() {
    local raw
    raw="$(gh pr view "$pr_url" --json statusCheckRollup,reviewDecision,headRefOid)" || return 1
    debug "ci-gate: raw check data: ${raw}"

    # Per-check diagnostics
    printf '%s' "$raw" | jq -r '
        (.statusCheckRollup // [])[] |
        "ci-gate: check typename=\(.__typename) name=\(.name // .context) status=\(.status // .state) conclusion=\(.conclusion // "N/A")"
    ' >&2

    printf '%s' "$raw" | jq -r '
(.reviewDecision // ""),
((.statusCheckRollup // []) | length),
(.headRefOid // "")
'
}

bail_review_required() {
    local decision="$1"
    if [ "$decision" = "REVIEW_REQUIRED" ]; then
        printf 'ci-gate: PR blocked by required human review\n' >&2
        exit 2
    fi
}

sha_matches() {
    local head_oid="$1"
    local expected="$2"
    [ "$head_oid" = "$expected" ] || git merge-base --is-ancestor "$expected" "$head_oid" 2>/dev/null
}

# --- main ---

info "ci-gate: awaiting CI availability for ${pr_url}"
if [ -z "$fix_head" ]; then
    # First iteration: resolve local HEAD so we can verify check-runs
    # belong to the current commit, not a stale previous push.
    fix_head="$(git rev-parse HEAD)"
    info "ci-gate: no fix_head provided, using local HEAD (${fix_head})"

    # Startup grace: wait for check-runs to appear AND SHA to sync.
    # Both must be satisfied — stale check-runs from a previous commit
    # must not be mistaken for current CI.
    # The grace deadline only applies to the no-checks-appeared case;
    # once checks appear we keep waiting for SHA sync (bounded by
    # the exec-stage timeout).
    grace_deadline=$(( $(date +%s) + startup_grace_secs ))
    rollup_len=0
    head_oid=""
    while true; do
        remaining=$(( grace_deadline - $(date +%s) ))
        info "ci-gate: waiting for check-runs to appear... ${remaining}s grace remaining"
        meta=$(fetch_meta)
        decision=$(printf '%s' "$meta" | sed -n '1p')
        rollup_len=$(printf '%s' "$meta" | sed -n '2p')
        head_oid=$(printf '%s' "$meta" | sed -n '3p')
        bail_review_required "$decision"
        if [ "$rollup_len" -gt 0 ] && sha_matches "$head_oid" "$fix_head"; then
            break
        fi
        # Only break on deadline when no checks have appeared at all.
        # If checks exist but SHA hasn't synced, keep waiting — the
        # exec-stage timeout will bound the total wait.
        if [ "$(date +%s)" -ge "$grace_deadline" ] && [ "$rollup_len" -eq 0 ]; then
            break
        fi
        sleep "$poll_interval"
    done
    if [ "$rollup_len" -eq 0 ]; then
        info "ci-gate: no check-runs after ${startup_grace_secs}s grace; skipping"
        printf 'skipped\n'
        exit 0
    fi
    info "ci-gate: ${rollup_len} check-run(s) found, SHA synced"
else
    # Post-fix: wait for GitHub to reflect the pushed commit SHA
    info "ci-gate: waiting for SHA sync (expecting ${fix_head})"
    while true; do
        meta=$(fetch_meta)
        decision=$(printf '%s' "$meta" | sed -n '1p')
        head_oid=$(printf '%s' "$meta" | sed -n '3p')
        info "ci-gate: SHA sync poll... current=${head_oid} expected=${fix_head}"
        bail_review_required "$decision"
        if sha_matches "$head_oid" "$fix_head"; then
            break
        fi
        sleep "$poll_interval"
    done
    info "ci-gate: SHA synced successfully"
fi
