#!/usr/bin/env bash
# Generate a cargo-modules structural report for review.
# Usage: cargo_modules_report <base_sha> <report_uri> <report_path> <tree_path> <dot_path> <adjacency_path>
# Produces:
#   <report_path>             — consolidated review report (markdown)
#   <tree_path>               — raw module trees (forensics)
#   <dot_path>                — raw DOT output (forensics)
#   <adjacency_path>          — collapsed module-level adjacency list
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/logging.sh"

BASE_SHA="${1:-}"
REPORT_URI="${2:-}"
REPORT_FILE="${3:-}"
TREE_OUT="${4:-}"
DOT_OUT="${5:-}"
ADJACENCY_OUT="${6:-}"

if [ -z "$BASE_SHA" ] || [ -z "$REPORT_URI" ] || [ -z "$REPORT_FILE" ] || [ -z "$TREE_OUT" ] || [ -z "$DOT_OUT" ] || [ -z "$ADJACENCY_OUT" ]; then
    die "Usage: cargo_modules_report <base_sha> <report_uri> <report_path> <tree_path> <dot_path> <adjacency_path>"
fi

# ---------- prerequisites ----------
if ! command -v cargo-modules &>/dev/null; then
    die "cargo-modules not found on PATH; install with: cargo install cargo-modules"
fi

# ---------- resolve project root ----------
# Use git rev-parse from cwd (the stage worktree), not GREMLINS_PROJECT_ROOT
# which may point at the operator's original checkout.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# ---------- validate base SHA ----------
if ! git -C "$PROJECT_ROOT" rev-parse --verify "$BASE_SHA^{commit}" &>/dev/null; then
    die "base SHA '$BASE_SHA' does not resolve to a commit in $PROJECT_ROOT"
fi

# ---------- changed modules ----------
CHANGED_FILES="$(git -C "$PROJECT_ROOT" diff --name-only "${BASE_SHA}...HEAD")"

# ---------- helper: strip ANSI (portable across GNU and BSD sed) ----------
strip_ansi() {
    sed -E $'s/\x1b\\[[0-9;]*[a-zA-Z]//g'
}

# ---------- packages ----------
PACKAGES=("gremlins" "gremlins-cli")

# ---------- run structure (once per package) ----------
info "collecting module trees"
{
    for pkg in "${PACKAGES[@]}"; do
        echo "## $pkg"
        echo
        cargo modules structure --no-fns --no-traits --no-types --package "$pkg" | strip_ansi
        echo
    done
} > "$TREE_OUT"

# ---------- run dependencies (once per package) — raw DOT ----------
info "collecting dependency graphs"
{
    for pkg in "${PACKAGES[@]}"; do
        echo "## $pkg"
        echo
        cargo modules dependencies \
            --no-externs --no-sysroot --no-owns \
            --no-fns --no-types --no-traits \
            --package "$pkg" | strip_ansi
        echo
    done
} > "$DOT_OUT"

# ---------- build adjacency list from raw DOT ----------
# DOT edge lines look like:
#     "gremlins::builders::agent" -> "gremlins::builders::artifacts" [label="uses", ...];
# With --no-fns --no-types --no-traits every node is already a module —
# no segment stripping needed.
info "building adjacency list"
{
    echo "# Module adjacency (cargo modules dependencies)"
    echo

    for pkg in "${PACKAGES[@]}"; do
        echo "## $pkg"
        echo

        # Extract edges from the raw DOT: "src" -> "dst"
        # Sort unique src->dst pairs, then collapse by src.
        # Filter to the current package's DOT section so each heading
        # only shows its own dependencies (both crates use the same
        # target name internally).
        awk -v pkg="$pkg" '
            /^## / { in_section = ($0 == "## " pkg) ? 1 : 0; next }
            in_section
        ' "$DOT_OUT" \
            | sed -nE 's/^[[:space:]]*"([^"]+)" -> "([^"]+)".*/\1 -> \2/p' \
            | sort -u \
            | awk -F' -> ' '
            {
                if ($1 == last) {
                    deps = deps ", " $2
                } else {
                    if (last) print "  " last " -> " deps
                    last = $1
                    deps = $2
                }
            }
            END { if (last) print "  " last " -> " deps }
        '
        echo
    done
} > "$ADJACENCY_OUT"

# ---------- helper: resolve a crate directory to its Rust target name ----------
# Reads Cargo.toml to find the [lib] or [[bin]] name, falling back to the
# directory name. This is necessary because e.g. crates/gremlins-cli/ has a
# [[bin]] target named "gremlins", not "gremlins-cli".
target_name_for() {
    local dir="$1"
    local toml="$PROJECT_ROOT/crates/$dir/Cargo.toml"
    if [ ! -f "$toml" ]; then
        echo "$dir"
        return
    fi
    # Extract name from [lib] or [[bin]] section (whichever comes first).
    sed -nE '
        /^\[lib\]$/,/^\[/ { s/^name[[:space:]]*=[[:space:]]*"(.+)"/\1/p; }
        /^\[\[bin\]\]$/,/^\[/ { s/^name[[:space:]]*=[[:space:]]*"(.+)"/\1/p; }
    ' "$toml" | head -1
}

# ---------- helper: map a changed file path to a module path ----------
module_path_for() {
    local file="$1"
    # Only Rust source files get module paths.
    if [[ "$file" != *.rs ]]; then
        echo ""
        return
    fi

    # Strip leading crates/<name>/src/
    local pkg_dir
    pkg_dir="$(echo "$file" | sed -nE 's|^crates/([^/]+)/src/.*|\1|p')"
    if [ -z "$pkg_dir" ]; then
        echo ""
        return
    fi

    # Resolve the Rust target name from the package directory.
    local crate
    crate="$(target_name_for "$pkg_dir")"
    if [ -z "$crate" ]; then
        crate="$pkg_dir"
    fi

    # Remove crates/<name>/src/ prefix and .rs suffix
    local rel
    rel="$(echo "$file" | sed -E 's|^crates/[^/]+/src/||; s|\.rs$||')"

    # Map lib.rs / main.rs to crate root
    case "$rel" in
        lib|main) echo "${crate}" ;;
        */mod)    echo "${crate}::$(echo "$rel" | sed 's|/mod$||; s|/|::|g')" ;;
        *)        echo "${crate}::$(echo "$rel" | sed 's|/|::|g')" ;;
    esac
}

# ---------- assemble consolidated report ----------
info "assembling report: $REPORT_FILE"

{
    echo "# Structural complexity report"
    echo
    echo "**Base SHA:** $BASE_SHA"
    echo "**Generated by:** cargo-modules"
    echo

    # Changed modules summary
    echo "## Changed modules"
    echo
    if [ -z "$CHANGED_FILES" ]; then
        echo "_No files changed between \`${BASE_SHA}...HEAD\`._"
    else
        echo "Files changed between \`${BASE_SHA}...HEAD\`:"
        echo

        while IFS= read -r file; do
            if [ -n "$file" ]; then
                mod_path="$(module_path_for "$file")"
                if [ -n "$mod_path" ]; then
                    echo "- \`$file\` → \`$mod_path\`"
                else
                    echo "- \`$file\`"
                fi
            fi
        done <<< "$CHANGED_FILES"
    fi
    echo

    # Module trees
    echo "## Module trees"
    echo
    echo '```'
    cat "$TREE_OUT"
    echo '```'
    echo

    # Adjacency lists
    echo "## Module-level dependencies"
    echo
    echo '```'
    cat "$ADJACENCY_OUT"
    echo '```'
    echo

    echo "## Raw artifacts"
    echo
    echo "- Full tree output: \`${REPORT_URI}.tree\`"
    echo "- Raw DOT graph: \`${REPORT_URI}.dot\`"
    echo "- Adjacency list: \`${REPORT_URI}.adjacency\`"

} > "$REPORT_FILE"

info "report written to ${REPORT_URI}"