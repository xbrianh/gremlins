{
  prompt_dir: "prompts",
  bootstrap: {
    source: {
      require_one_of: [
        ["instructions", "plan"],
      ],
      instructions: {
        type: "string",
        optional: true,
      },
      plan: {
        type: "filepath",
        optional: true,
      },
      base_ref: {
        type: "string",
        optional: true,
      },
    },
    launch_cmds: [
      'gremlins:bind_artifact("artifact://plan.md", plan)',
      'gremlins:bind_artifact("artifact://instructions.md", instructions)',
      'gremlins:bind_artifact("artifact://base_ref", base_ref)',
      'BASE_REF={base_ref} && SHA=$(git -C "$GREMLINS_PROJECT_ROOT" rev-parse --verify "${BASE_REF:-HEAD}") && git -C "$GREMLINS_PROJECT_ROOT" worktree add --detach "$GREMLIN_WORKDIR" "$SHA" && echo "$SHA" > "$GREMLINS_STATE_DIR/artifacts/base_sha"',
    ],
    cli_out: {
      base_sha: "artifact://base_sha",
    },
    env: 'export GREMLINS_OPENAI_AGENTS_MAX_TURNS=\'1000\'\nexport CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${GREMLINS_PROJECT_ROOT}/.cargo-gremlin-target}"\nexport CARGO_INCREMENTAL=0\nTHE_ENV="${GREMLINS_PROJECT_ROOT}/.gremlins/env"\nif [ -f "$THE_ENV" ]; then\n    source "$THE_ENV"\nfi\nexport PREFIX="${GREMLINS_STATE_DIR}/install"\nexport PATH="${GREMLINS_PROJECT_ROOT}/.gremlins/bin:${PATH}"\n',
  },
  land: {
    interpolation: {
      inputs: {
        message: "artifact://commit_message.txt",
      },
    },
    land_cmds: [
      'WORKTREE_HEAD=$(git -C "$GREMLIN_WORKDIR" rev-parse HEAD)',
      'git merge --squash "$WORKTREE_HEAD"',
      'git diff --cached --quiet || git commit -F "{message}"',
    ],
    clean_cmds: [
      'git worktree remove --force "$GREMLIN_WORKDIR" || true',
      "git worktree prune",
    ],
  },
  "stage-definitions": {
    "check-and-fix": "check-and-fix",
  },
  stages: [
    {
      name: "plan",
      type: "plan",
      prompt: ["style_guide.md", "plan.md"],
    },
    {
      name: "implement-and-qa",
      type: "implement-and-qa",
      options: {
        verify_cmds: "make -j8 check && make -j8 test",
      },
    },
    {
      name: "commit-message",
      type: "agent",
      prompt: ["commit_message.md"],
      interpolation: {
        inputs: {
          plan: 'content("artifact://plan.md")',
          diff: 'content("artifact://diff.txt")',
          address_summary: 'content("artifact://address-summary.md")',
        },
        outputs: {
          commit_message: "artifact://commit_message.txt",
        },
      },
    },
  ],
}
