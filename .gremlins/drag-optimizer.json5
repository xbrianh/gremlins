{
  prompt_dir: "prompts",
  // Drag score optimizer — iterative refactoring loop driven by gremlins-drag.
  //
  // Usage:
  //   gremlins launch drag-optimizer --target crates/gremlins/src/lib.rs
  //   gremlins launch drag-optimizer --target src/ --drag-model openai/gpt-4o
  //   gremlins launch drag-optimizer --target my_pkg/ --instructions "focus on cyclomatic complexity"
  //
  // Parameters (launch-time):
  //   target                    (required)  module file or package directory to refactor
  //   drag-model                (optional)  model for comprehensibility scoring (gremlins-drag --model)
  //   instructions              (optional)  extra guidance injected into the per-iteration refactoring prompt
  //   base_ref                  (optional)  git ref to check out for the isolated worktree (default: HEAD)
  //   estimates-per-survey      (optional)  number of LLM estimates per survey (default: 5)
  //
  // NOTE: the bootstrap source is named `drag-model` (not `model`) because `model`
  // collides with gremlins' own global --model flag.  Pass `--drag-model provider/model`
  // to forward a model spec to gremlins-drag.
  //
  // How it works:
  //   1. Baseline — run gremlins-drag once to capture the starting score.
  //   2. Loop (max 11 iterations), split into three stages:
  //      a. Plan — an agent inspects the latest drag reports, considers the
  //         drivers of the drag score and candidate strategies, and writes a
  //         concrete implementation plan.
  //      b. Implement & QA — implement the plan, then verify, review, and
  //         address review feedback (delegates to implement-and-qa).
  //      c. Evaluate — re-run gremlins-drag, compare before/after drag, write
  //         an evaluation report, and bail if the iteration made no progress.
  //   3. Land — merge the worktree back into the main branch (manual via
  //      `gremlins land`).
  bootstrap: {
    source: {
      target: {
        type: "string",
      },
      "drag-model": {
        type: "string",
        optional: true,
      },
      instructions: {
        type: "string",
        optional: true,
      },
      base_ref: {
        type: "string",
        optional: true,
      },
      "estimates-per-survey": {
        type: "string",
        optional: true,
        default: "5",
      },
      p: {
        type: "string",
        optional: true,
      },
      "skip-maintainability": {
        type: "string",
        optional: true,
      },
      "drag-config": {
        type: "filepath",
        optional: true,
      },
    },
    launch_cmds: [
      'printf "%s" {target} > "$GREMLINS_STATE_DIR/artifacts/target.txt"',
      'printf "%s" {drag-model} > "$GREMLINS_STATE_DIR/artifacts/drag_model.txt"',
      'printf "%s" {instructions} > "$GREMLINS_STATE_DIR/artifacts/instructions.txt"',
      'printf "%s" {estimates-per-survey} > "$GREMLINS_STATE_DIR/artifacts/comp_estimates.txt"',
      'printf "%s" {p} > "$GREMLINS_STATE_DIR/artifacts/p.txt"',
      'printf "%s" {skip-maintainability} > "$GREMLINS_STATE_DIR/artifacts/skip_maint.txt"',
      'BASE_REF={base_ref} && SHA=$(git -C "$GREMLINS_PROJECT_ROOT" rev-parse --verify "${BASE_REF:-HEAD}") && git -C "$GREMLINS_PROJECT_ROOT" worktree add --detach "$GREMLIN_WORKDIR" "$SHA" && printf "%s" "$SHA" > "$GREMLINS_STATE_DIR/artifacts/base_sha"',
      // Build the drag config JSON file.  Scoring parameters come from the
      // project config (or --drag-config override) with bootstrap overrides.
      // The config file is written to TWO places:
      //   1. $GREMLINS_STATE_DIR/artifacts/drag_config.json — immutable artifact
      //   2. $GREMLINS_STATE_DIR/drag_config.json — mutable, pointed to by
      //      GREMLINS_DRAG_CLI_CONFIG so agents pick it up automatically.
      // The target is injected as the "path" field so gremlins-drag needs
      // no positional arguments.
      'CONFIG_SRC="{drag-config}"; if [ -n "$CONFIG_SRC" ] && [ -f "$CONFIG_SRC" ]; then echo "using drag config: $CONFIG_SRC"; sed "s|^[[:space:]]*//.*||" "$CONFIG_SRC" > "$GREMLINS_STATE_DIR/artifacts/drag_config.json"; else sed "s|^[[:space:]]*//.*||" "$GREMLINS_PROJECT_ROOT/.gremlins/drag-config.json" > "$GREMLINS_STATE_DIR/artifacts/drag_config.json"; fi',
      "MODEL_VAL=\"{drag-model}\" && ESTIMATES_VAL=\"{estimates-per-survey}\" && P_VAL=\"{p}\" && SKIP_MAINT_VAL=\"{skip-maintainability}\" && [ -z \"$ESTIMATES_VAL\" ] && ESTIMATES_VAL=\"5\" && [ -z \"$P_VAL\" ] && P_VAL=\"2.5\" && jq --arg model \"$MODEL_VAL\" --argjson estimates \"$ESTIMATES_VAL\" --argjson p_val \"$P_VAL\" --arg skip_maint \"$SKIP_MAINT_VAL\" --arg target \"{target}\" 'if $model != \"\" then .model = $model else . end | .estimates_per_survey = $estimates | .weights.p = $p_val | if $skip_maint != \"\" and $skip_maint != \"false\" then .skip_maintainability = true else . end | .path = $target' \"$GREMLINS_STATE_DIR/artifacts/drag_config.json\" > \"$GREMLINS_STATE_DIR/artifacts/drag_config_tmp.json\" && mv \"$GREMLINS_STATE_DIR/artifacts/drag_config_tmp.json\" \"$GREMLINS_STATE_DIR/artifacts/drag_config.json\" && cp \"$GREMLINS_STATE_DIR/artifacts/drag_config.json\" \"$GREMLINS_STATE_DIR/drag_config.json\"",
    ],
    cli_out: {
      target: "artifact://target.txt",
      drag_model: "artifact://drag_model.txt",
      instructions: "artifact://instructions.txt",
      base_sha: "artifact://base_sha",
      estimates_per_survey: "artifact://comp_estimates.txt",
      p: "artifact://p.txt",
      skip_maintainability: "artifact://skip_maint.txt",
    },
    env: "export GREMLINS_OPENAI_AGENTS_MAX_TURNS='1000'\nTHE_ENV=\"${GREMLINS_PROJECT_ROOT}/.gremlins/env\"\nif [ -f \"$THE_ENV\" ]; then\n    source \"$THE_ENV\"\nfi\nexport PATH=\"${GREMLINS_PROJECT_ROOT}/.gremlins/bin:${PATH}\"\n# Drag config is built as a JSON file during launch_cmds from the bundled\n# config with bootstrap parameter overrides.  All gremlins-drag invocations\n#     env: "export GREMLINS_OPENAI_AGENTS_MAX_TURNS='1000'\nTHE_ENV=\"${GREMLINS_PROJECT_ROOT}/.gremlins/env\"\nif [ -f \"$THE_ENV\" ]; then\n    source \"$THE_ENV\"\nfi\nexport PATH=\"${GREMLINS_PROJECT_ROOT}/.gremlins/bin:${PATH}\"\nexport GREMLINS_DRAG_CLI_CONFIG=\"$GREMLINS_STATE_DIR/drag_config.json\"\n# GREMLINS_DRAG_CLI_CONFIG points to the mutable drag config file, which\n# includes the target path.  All gremlins-drag invocations — pipeline\n# stages AND agent self-assessments — read from this config, so every\n# invocation uses identical scoring parameters and the correct target.\n", — pipeline stages AND\n# agent self-assessments — uses identical scoring parameters.\n",
  },
  stages: [
    // ── baseline ──────────────────────────────────────────────────────────
    {
      name: "baseline",
      type: "exec",
      interpolation: {
        inputs: {
          target: 'content("artifact://target.txt")',
          base_sha: "artifact://base_sha",
        },
        outputs: {
          report: "artifact://baseline/report.json",
          drag_best: "artifact://drag_best.txt",
          progression: "artifact://drag_progression.json",
        },
      },
      options: {
        cmds: [
          'gremlins-drag > {report}',
          'cp {report} "$GREMLINS_STATE_DIR/drag_current.json"',
          "cat {report} | jq '.drag' > {drag_best}\n",
          'echo "baseline sum drag = $(cat {drag_best})"',
          'if [ -f {progression} ]; then\n  echo "drag_progression.json already exists; skipping baseline seed"\nelse\n  BASE_SHA=$(cat {base_sha}) && DRAG=$(jq \'.drag\' < {report}) && jq -n --arg target "{target}" --arg base_sha "$BASE_SHA" --argjson drag "$DRAG" \'[{"iteration":"baseline","target":$target,"iter_start_sha":$base_sha,"iter_end_sha":$base_sha,"drag_before":null,"drag_after":$drag,"drag_delta":null,"commits":null,"verdict":"baseline"}]\' > {progression} && echo "seeded drag_progression.json (baseline drag=$DRAG)"\nfi',
        ],
      },
    },
    // ── drag model explanation (formula, surveys, curves) ────────────────
    {
      name: "explain",
      type: "exec",
      interpolation: {
        outputs: {
          explain: "artifact://explain.txt",
        },
      },
      options: {
        cmds: [
          'gremlins-drag --explain > {explain}',
        ],
      },
    },
    // ── optimize loop ─────────────────────────────────────────────────────
    // Each iteration runs plan → implement-and-qa → score → evaluate.
    // The exec stages around those (context prep, scoring) are plumbing that
    // keep the worktree, artifacts, and state files consistent.
    {
      name: "optimize",
      type: "sequence",
      "max-iterations": 11,
      body: [
        // --- prepare the drag context (current + previous reports) ---
        {
          name: "prepare-context",
          type: "exec",
          interpolation: {
            outputs: {
              context: "artifact://{loop_iter}/drag_context.md",
              iter_start_sha: "artifact://{loop_iter}/iter_start_sha.txt",
              progression_in: "artifact://{loop_iter}/progression_in.json",
            },
          },
          options: {
            cmds: [
              'git -C "$GREMLIN_WORKDIR" rev-parse HEAD > "$GREMLINS_STATE_DIR/artifacts/{loop_iter}/iter_start_sha.txt"',
              // Update the mutable drag config with this iteration's target.
              // Iteration 1 reads the bootstrap config; subsequent iterations
              // read the previous iteration's drag config artifact (which may
              // have been broadened by record-progression).
              'if [ "{loop_iter}" = "1" ]; then
  PREV_CONFIG="$GREMLINS_STATE_DIR/artifacts/drag_config.json"
else
  PREV=$(({loop_iter} - 1))
  PREV_CONFIG="$GREMLINS_STATE_DIR/artifacts/$PREV/drag_config.json"
fi
if [ ! -f "$PREV_CONFIG" ]; then
  PREV_CONFIG="$GREMLINS_STATE_DIR/drag_config.json"
fi
TARGET=$(jq -r \'.path\' "$PREV_CONFIG")
jq --arg t "$TARGET" \'.path = $t\' "$GREMLINS_STATE_DIR/drag_config.json" > "$GREMLINS_STATE_DIR/drag_config_tmp.json" && mv "$GREMLINS_STATE_DIR/drag_config_tmp.json" "$GREMLINS_STATE_DIR/drag_config.json"
echo "prepare-context: target=$TARGET"
',
              // Copy the latest cumulative progression into a scoped artifact
              // for this iteration.  Iteration 1 reads the baseline seed;
              // subsequent iterations read the previous iteration's output.
              'if [ "{loop_iter}" = "1" ]; then
  cp "$GREMLINS_STATE_DIR/artifacts/drag_progression.json" {progression_in}
else
  PREV=$(({loop_iter} - 1))
  cp "$GREMLINS_STATE_DIR/artifacts/$PREV/drag_progression.json" {progression_in}
fi
',
              'STATE_DIR="$GREMLINS_STATE_DIR"\n{\n  if [ -f "$STATE_DIR/drag_previous.json" ]; then\n    echo "## Drag report before the last refactor (previous state)"\n    echo \'```json\'\n    cat "$STATE_DIR/drag_previous.json"\n    echo \'```\'\n    echo ""\n  fi\n  echo "## Drag report after the last refactor (current state)"\n  echo \'```json\'\n  cat "$STATE_DIR/drag_current.json"\n  echo \'```\'\n} > {context}\n',
            ],
          },
        },
        // --- plan: choose a strategy and write an implementation plan ---
        {
          name: "drag-optimize-plan",
          type: "agent",
          interpolation: {
            inputs: {
              drag_context: 'content("artifact://{loop_iter}/drag_context.md")',
              instructions: 'content("artifact://instructions.txt")',
              explain: 'content("artifact://explain.txt")',
            },
            outputs: {
              plan: "artifact://{loop_iter}/plan.md",
            },
          },
          prompt: [
            'You are planning a refactor of the target at {target} to reduce its drag score.\n\n**Your overriding goal is simple, beautiful, correct code.** Drag is the\nmetric, but genuine maintainability is the objective. The best refactorings\nare often the hardest — restructuring module boundaries, untangling\ncontrol flow, redesigning abstractions. Do not reach for the easy change\nwhen the right change is within reach. Effort spent now on quality means\nfar less maintenance burden later.\n\nThe reports below are the most recent drag analyses. The "current\nstate" report describes the code you are about to change. When a\n"previous state" report is present, it describes the code before the\nlast refactor, so you can compare what changed and how drag moved.\n\n{drag_context}\n\n## Drag model (how drag is computed)\n\n{explain}\n\n## How refactoring moves affect the score\n\n### token_count\nReducing a module\'s own token count directly lowers its footprint\n(since footprint includes the module itself) and may also reduce\nfootprints of upstream modules that transitively depend on it.\nSmaller total code means less surface area for bugs and lower\ncognitive load. However, token_count alone is a small part of the\ntotal drag: the comprehensibility and package-maintainability\nmultipliers can each amplify drag by up to ~12× (when m=2.5 or\np=2.5). The footprint multiplier (1+footprint)^w2 is unbounded.\n\n### footprint\nA module\'s footprint is the token sum of everything it transitively\ndepends on. Breaking deep dependency chains, inlining small\nsingle-use helpers back into their callers, and avoiding unnecessary\ncross-module couplings all reduce footprint. When a module is\nrefactored to depend on fewer other modules, its footprint\nshrinks — and every upstream module that depends on it may also\nbenefit. Footprint enters the formula as (1+footprint)^w2; larger\nfootprints amplify drag sub-linearly (w2=0.5 gives square-root\ngrowth).\n\n### comprehensibility\nComprehensibility is a multiplier on the footprint term:\nexp(m·(1−comp)). The survey and its seven dimensions (naming,\ncontrol_flow, data_flow, abstractions, cohesion, sizing,\ntest_hygiene) are described in the drag model above. To raise\ncomprehensibility, target the dimensions dragging a module\'s score\ndown: split dumping-ground files by concern (cohesion), break up\nmega-functions (sizing), and relocate inline tests out of the\nproduction file (test_hygiene), alongside naming, control-flow,\ndata-flow, and abstraction improvements. The effect is\nmultiplicative with footprint, so improving comprehensibility on\na high-footprint module yields more drag reduction than on a\nlow-footprint one.\n\n### package maintainability (only when `maint_score` is present)\nPackage maintainability is scored on ten dimensions (each 0–4),\nnormalized over 40 points; the dimensions and their anchors are\ndescribed in the drag model above. The package multiplier\nexp(p·(1−maint)) amplifies the sum of module drags within that\npackage; low maintainability can increase effective drag by up to\nexp(p). Improving any of the ten dimensions — extracting duplicated\nlogic into shared helpers, isolating changes to fewer files,\ntightening cross-module interfaces, flattening deep transitive\nchains, reducing public API surface, or sealing abstraction\nboundaries — raises maint_score and shrinks the package multiplier.\n\n## Splitting vs merging modules\n\nSplitting one module into two can increase or decrease total drag\ndepending on how the split affects each factor:\n\n- **token_count**: Splitting redistributes tokens across modules.\n  Total token_count across the package may stay roughly the same\n  (modulo any new imports, re-exports, or glue code).\n- **footprint**: Each half may still carry the same shared\n  transitive dependencies. If module A imports module B, A\'s\n  footprint includes B\'s tokens plus everything B depends on —\n  so splitting can increase the sum of footprints even when total\n  tokens are unchanged.\n- **comprehensibility**: Smaller, focused modules may be easier\n  to understand (raising comp). Conversely, fragmentation across\n  many files can obscure the overall design and force readers to\n  jump between files (lowering comp). The net effect depends on\n  whether the split creates clean conceptual boundaries or scatters\n  related logic.\n- **package maintainability** (when packages are present): More\n  modules may affect decomposition, change isolation, and\n  duplication scores. A split that creates clean, independent\n  boundaries can improve these dimensions. A split that scatters\n  related logic across files can hurt them. When no packages are\n  scored, this dimension does not apply.\n\nExample — splitting one module into two when both still share the\nsame transitive dependencies:\n\nOne module (2000 tokens, footprint 5000, comp 0.5, w2=0.5, m=2.5):\n  drag = (1+5000)^0.5 · exp(2.5·0.5) ≈ 70.7 · 3.49 ≈ 246.8\n\nSplit into A (1000 tokens) and B (1000 tokens), where A depends on B\nand both depend on shared downstream modules (3000 tokens beyond\nA/B themselves):\n  drag(A) = (1+5000)^0.5 · exp(2.5·0.5) ≈ 70.7 · 3.49 ≈ 246.8\n  drag(B) = (1+4000)^0.5 · exp(2.5·0.5) ≈ 63.3 · 3.49 ≈ 220.8\n  total ≈ 467.6\n\nHere splitting increased total drag because both halves still carry\nthe shared footprint. The outcome can differ when a split severs\nreal dependency edges (reducing actual transitive reach) or when\ncomprehensibility improves enough to offset the footprint penalty.\n\nMerging two modules reverses the analysis: footprint may decrease\n(fewer module-to-module edges), but comprehensibility may suffer if\nthe result is a large, unfocused file. When packages are present,\nthe net effect on package maintainability dimensions depends on\nwhether the merge consolidates related logic or creates a monolithic\nblob. When no packages are scored, this dimension does not apply.\n\n## Your job\n\n- Consider the drivers of the drag score in the current state and\n  identify the highest-leverage changes.\n- Consider multiple strategies — footprint reduction,\n  comprehensibility improvements, package-maintainability\n  improvements, and splitting vs merging modules — and choose the\n  one most likely to reduce total drag.\n- **Prioritize correctness and code quality above all else.**\n  The goal is simple, beautiful, correct code. Do not shy away\n  from difficult refactorings — effort spent now to improve the\n  codebase means much less maintenance effort in the future.\n  Prefer the change that makes the code genuinely better, even\n  when it requires more work: restructuring module boundaries,\n  untangling complex control flow, redesigning abstractions,\n  flattening deep dependency chains, or consolidating scattered\n  logic into coherent modules.\n- **Test code does not count toward token_count or footprint.**\n  `gremlins-drag` strips `#[cfg(test)]` items before counting\n  tokens, so moving test code never changes the footprint term.\n  Test_hygiene is the **least impactful** of the seven\n  comprehensibility dimensions — it can raise comp by at most a\n  few hundredths, which is negligible compared to footprint\n  reduction or improvements to sizing/cohesion/control-flow.\n- **A `mod tests` block already cleanly separated at the bottom\n  of a file is good test_hygiene.** Do not mechanically extract\n  these blocks into separate test files — it creates git churn\n  for zero measurable drag benefit.\n- Only consider test relocation when tests are genuinely\n  **interleaved with production code** in the same file (e.g.,\n  helper functions immediately followed by their unit tests).\n  Even then, treat it as a side effect of restructuring\n  production code, never as a standalone plan item.\n- **Test-only changes do not count as progress.** A plan whose\n  primary effect is test reorganization will be rolled back.\n- Write a concrete, ordered implementation plan. For each step, name\n  the file(s), describe the specific change, and explain why it\n  should reduce drag.\n- Size the plan to the problem, not to an arbitrary limit. If the\n  right fix touches many files and restructures module boundaries,\n  that is fine — describe every step needed for a complete,\n  correct implementation. The only constraint: the plan must be\n  completable in a single pass without bailing for help.\n- Do NOT edit any source files in this stage. Only write the plan.\n\nWrite the plan to `{plan}`.\n\n## Additional guidance\n{instructions}\n',
          ],
          //# Your job
          //# Additional guidance
          options: {
            idle_timeout: 600,
          },
        },
        // --- implement & QA: apply the plan, verify, review, and address feedback ---
        {
          name: "implement-and-qa",
          type: "implement-and-qa",
          options: {
            verify_cmds: "make -j8 check && make -j8 test",
            diff_base: "artifact://{loop_iter}/iter_start_sha.txt",
            artifact_ns: "{loop_iter}/",
          },
        },
        // --- cleanup build artifacts so scoring is not inflated ---
        {
          name: "cleanup-build-artifacts",
          type: "exec",
          options: {
            cmds: [
              "cargo clean 2>/dev/null || true",
              "find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true",
              "find . -type f -name '*.pyc' -delete 2>/dev/null || true",
            ],
          },
        },
        // --- score: re-measure drag and rotate state for the next iteration ---
        {
          name: "score",
          type: "exec",
          interpolation: {
            inputs: {
            },
            outputs: {
              report: "artifact://{loop_iter}/report.json",
              drag_before: "artifact://{loop_iter}/drag_before.txt",
              drag_after: "artifact://{loop_iter}/drag_after.txt",
              iter_end_sha: "artifact://{loop_iter}/iter_end_sha.txt",
              commit_count: "artifact://{loop_iter}/commit_count.txt",
            },
          },
          options: {
            cmds: [
              'gremlins-drag > {report}',
              'STATE_DIR="$GREMLINS_STATE_DIR"\ndrag_sum() {\n  jq '.drag' < "$1"\n}\nif [ -f "$STATE_DIR/drag_current.json" ]; then\n  drag_sum "$STATE_DIR/drag_current.json" > {drag_before}\n  cp "$STATE_DIR/drag_current.json" "$STATE_DIR/drag_previous.json"\nelse\n  printf "0" > {drag_before}\nfi\ncp {report} "$STATE_DIR/drag_current.json"\n',
              'STATE_DIR="$GREMLINS_STATE_DIR"\ndrag_sum() {\n  jq '.drag' < "$1"\n}\nAFTER=$(drag_sum "$STATE_DIR/drag_current.json")\nprintf "%s" "$AFTER" > {drag_after}\nBEST=$(cat "$GREMLINS_STATE_DIR/artifacts/drag_best.txt" 2>/dev/null)\nif ! awk -v a="$AFTER" -v b="$BEST" \'BEGIN { exit (b < a) ? 0 : 1 }\' 2>/dev/null; then\n  BEST="$AFTER"\nfi\nprintf "%s" "$BEST" > "$GREMLINS_STATE_DIR/artifacts/drag_best.txt"\necho "iteration {loop_iter} drag = $AFTER (best = $BEST)"\n',
              'git -C "$GREMLIN_WORKDIR" rev-parse HEAD | tr -d \'\n\' > {iter_end_sha}',
              'ITER_START=$(cat "$GREMLINS_STATE_DIR/artifacts/{loop_iter}/iter_start_sha.txt" 2>/dev/null) || { echo "FATAL: iter_start_sha.txt missing for {loop_iter}" >&2; exit 1; }\nCOMMITS=$(git -C "$GREMLIN_WORKDIR" rev-list --count "$ITER_START..HEAD" 2>/dev/null || echo "0")\nprintf "%s" "$COMMITS" > {commit_count}',
            ],
          },
        },
        // --- evaluate: agent judges legitimacy (gaming detection only — QA already verified correctness) ---
        // `drag_reduced` is a required output — only written for legitimate,
        // drag-reducing iterations. Missing → bail for operator review.
        // Exception: when fewer than 3 entries exist in the progression
        // artifact, non-improving iterations still write `reduced` so the
        // optimizer can gather enough data points.
        {
          name: "drag-optimize-evaluate",
          type: "agent",
          interpolation: {
            inputs: {
              plan: 'content("artifact://{loop_iter}/plan.md")',
              drag_before: 'content("artifact://{loop_iter}/drag_before.txt")',
              drag_after: 'content("artifact://{loop_iter}/drag_after.txt")',
              iter_start_sha: 'content("artifact://{loop_iter}/iter_start_sha.txt")',
              progression: 'content("artifact://{loop_iter}/progression_in.json")',
            },
            outputs: {
              drag_reduced: "artifact://{loop_iter}/drag_reduced.txt",
            },
          },
          prompt: [
            'Evaluate the just-completed refactoring iteration for {target}.\n\n## Drag scores\n\n- Before: {drag_before}\n- After: {drag_after}\n\n## The plan\n\n{plan}\n\n## Drag progression so far\n\n{progression}\n\n## Your job\n\nQA (verification, semantic review, complexity review) has already run and\npassed — the code compiles, tests pass, and reviewers approved the design.\nYour ONLY job is to detect **score gaming**: changes whose primary effect\nis to manipulate the drag formula without genuinely making the code easier\nto understand, modify, or maintain.\n\nRun read-only git commands (`git diff {iter_start_sha}`, `git log`, `git show`)\nto inspect exactly what changed.\n\n### Score gaming patterns to look for\n\nUse your judgment — don\'t pattern-match mechanically. Examples:\n\n- Cosmetic-only changes: renames without clarity gain, reordering\n  without structural benefit, whitespace-only changes\n- Splitting files without reducing actual coupling\n- Adding indirection that obscures rather than clarifies\n- Mechanically extracting `#[cfg(test)] mod tests` blocks that are\n  already cleanly separated at the bottom of a production file into\n  separate test files — pure churn with zero hygiene gain\n- Moving, splitting, or reorganizing test code without improving\n  test_hygiene\n- Deleting or weakening tests to shrink a file (breaks correctness;\n  also pointless for drag since tests are stripped from token counts)\n\n### Legitimate refactoring\n\nLegitimate changes make the code genuinely easier to maintain:\nsimpler control flow, reduced coupling, better abstractions, less\nduplication, tighter APIs, clearer names, flatter dependency chains,\nsplitting dumping-ground files by concern, breaking up mega-functions,\nand relocating tests that are genuinely interleaved with production\ncode (not already in a clean bottom-of-file `mod tests` block).\n\n**Scope is not a signal of gaming.** A refactoring that touches many\nfiles to restructure module boundaries or untangle complex coupling is\nentirely legitimate. Judge the quality of the changes, not the size of\nthe diff.\n\n### Your verdict\n\nWrite ONLY one word — your verdict — to `{drag_reduced}`. You MAY run\nread-only git commands (`git diff`, `git log`, `git show`) to inspect\nchanges. Do NOT run mutating git commands and do NOT modify any files.\nAn exec stage after this one handles rollback if needed.\n\n**Legitimate AND drag improved (after < before):**\nWrite `reduced`. The iteration succeeded.\n\n**Legitimate BUT drag did not improve:**\nCheck the drag progression above. Count the entries (baseline +\niterations). If there are fewer than 3 entries, write `reduced` — the\noptimizer needs at least a few attempts to understand the codebase\'s\ndrag drivers; early non-improving iterations are expected and should\nnot bail. Otherwise (3+ entries and no improvement), write\n`no_progress`. The pipeline will record this iteration and then bail\nfor operator review.\n\n**Score gaming:**\nWrite `rolled_back`. An exec stage will undo the commit and repair\nthe state files. Explain clearly what gaming pattern you detected.\n\nSummary:\n- Write `reduced` → drag improved (or < 3 entries, keep going), loop continues.\n- Write `rolled_back` → gaming, loop continues after exec rollback.\n- Write `no_progress` → no improvement with 3+ entries, record and bail for operator review.\n',
          //# Your job
          //# Your verdict
          options: {
            idle_timeout: 600,
          },
        },
        // --- rollback: deterministic exec that handles the evaluate verdict ---
        {
          name: "rollback",
          type: "exec",
          interpolation: {
            inputs: {
              verdict_path: "artifact://{loop_iter}/drag_reduced.txt",
              iter_start_sha: 'content("artifact://{loop_iter}/iter_start_sha.txt")',
            },
          },
          options: {
            cmds: [
              '# Read and sanitize the verdict. The evaluate agent always writes a verdict.\nVERDICT=""\nif [ -f {verdict_path} ]; then\n  VERDICT=$(tr -d \'\\n\' < {verdict_path})\nfi\n\n# Apply the verdict.\nif [ "$VERDICT" = "rolled_back" ]; then\n  echo "rolling back iteration {loop_iter} (gaming detected)"\n  git -C "$GREMLIN_WORKDIR" reset --hard {iter_start_sha}\n  if [ -f "$GREMLINS_STATE_DIR/drag_previous.json" ]; then\n    cp "$GREMLINS_STATE_DIR/drag_previous.json" "$GREMLINS_STATE_DIR/drag_current.json"\n    DRAG_BEFORE=$(cat "$GREMLINS_STATE_DIR/artifacts/{loop_iter}/drag_before.txt" 2>/dev/null)\n    printf "%s" "${DRAG_BEFORE:-0}" > "$GREMLINS_STATE_DIR/artifacts/drag_best.txt"\n    echo "restored drag_best to pre-iteration value"\n  fi\nelif [ "$VERDICT" = "reduced" ]; then\n  echo "iteration {loop_iter} is legitimate with drag improvement"\nelif [ "$VERDICT" = "no_progress" ]; then\n  echo "iteration {loop_iter}: no progress with 3+ entries; recording and bailing"\nelse\n  echo "iteration {loop_iter} verdict is unknown or empty: $VERDICT"\nfi\n',
            ],
          },
        },
        // --- record-progression: append iteration entry to the progression artifact ---
        // When the target broadens (changed files span a wider common root),
        // this stage recomputes ALL prior progression entries by checking out
        // each entry's iter_end_sha and re-running gremlins-drag with the new
        // target.  It also updates the mutable drag config (pointed to by
        // GREMLINS_DRAG_CLI_CONFIG) and saves a config snapshot artifact.
        // Delegates to the helper script drag-record-progression.
        {
          name: "record-progression",
          type: "exec",
          interpolation: {
            inputs: {
              base_sha_val: 'content("artifact://base_sha")',
              progression_in: "artifact://{loop_iter}/progression_in.json",
            },
            outputs: {
              progression_out: "artifact://{loop_iter}/drag_progression.json",
              config_out: "artifact://{loop_iter}/drag_config.json",
            },
          },
          options: {
            cmds: [
              'drag-record-progression \
  "$GREMLIN_WORKDIR" \
  "$GREMLINS_STATE_DIR" \
  "{base_sha_val}" \
  "{loop_iter}" \
  "$GREMLINS_STATE_DIR/drag_config.json" \
  {progression_in} \
  {progression_out} \
  {config_out}',
            ],
          },
        },
      ],
    },
    // ── commit message ────────────────────────────────────────────────────
    {
      name: "commit-message",
      type: "exec",
      interpolation: {
        inputs: {
          baseline_report: "artifact://baseline/report.json",
          drag_best_val: 'content("artifact://drag_best.txt")',
        },
        outputs: {
          commit_message: "artifact://commit_message.txt",
        },
      },
      options: {
        cmds: [
          // Find the latest cumulative progression and scoped target.
          // Each iteration writes artifact://{N}/drag_progression.json
                    // Each iteration writes artifact://{N}/drag_progression.json
          // and artifact://{N}/drag_config.json; pick the newest.
          'LATEST=$(ls -t "$GREMLINS_STATE_DIR/artifacts/"*/drag_progression.json 2>/dev/null | head -1)\nFALLBACK="$GREMLINS_STATE_DIR/artifacts/drag_progression.json"\nPROGRESSION="${LATEST:-$FALLBACK}"\nLATEST_CONFIG=$(ls -t "$GREMLINS_STATE_DIR/artifacts/"*/drag_config.json 2>/dev/null | head -1)\nif [ -n "$LATEST_CONFIG" ]; then\n  TARGET=$(jq -r \'.path\' "$LATEST_CONFIG")\nelse\n  TARGET=$(jq -r \'.path\' "$GREMLINS_STATE_DIR/artifacts/drag_config.json")\nfi\nBEST="{drag_best_val}"\n[ -z "$BEST" ] && BEST="N/A"\nBASE_SUM=$(jq \'.drag\' < {baseline_report})\nITER_COUNT=$(jq \'. | length - 1\' "$PROGRESSION" 2>/dev/null || echo "0")\nTRAJECTORY=$(jq -r \'[.[] | select(.verdict == "reduced" or .verdict == "baseline") | "\\(.iteration): \\(.drag_after)"] | join(" → ")\' "$PROGRESSION" 2>/dev/null)\n{\n  echo "drag-optimizer: reduce drag for $TARGET"\n  echo ""\n  echo "Baseline drag sum: $BASE_SUM → Best: $BEST"\n  echo "Trajectory: $TRAJECTORY"\n  echo "Iterations: $ITER_COUNT"\n  echo "Target: $TARGET"\n} > {commit_message}\n',
        ],
      },
    },
  ],
  land: {
    interpolation: {
      inputs: {
        message: "artifact://commit_message.txt",
      },
    },
    land_cmds: [
      'WORKTREE_HEAD=$(git -C "$GREMLIN_WORKDIR" rev-parse HEAD)',
      'git merge --squash "$WORKTREE_HEAD"',
      'git diff --cached --quiet || git commit -F "{message}"',
    ],
    clean_cmds: [
      'git worktree remove --force "$GREMLIN_WORKDIR" || true',
      "git worktree prune",
    ],
  },
}
