{
  // Drag score optimizer — iterative refactoring loop driven by gremlins-drag.
  //
  // Usage:
  //   gremlins launch drag-optimizer --target crates/gremlins/src/lib.rs
  //   gremlins launch drag-optimizer --target src/ --drag-model openai/gpt-4o
  //   gremlins launch drag-optimizer --target my_pkg/ --instructions "focus on cyclomatic complexity"
  //
  // Parameters (launch-time):
  //   target                    (required)  module file or package directory to refactor
  //   drag-model                (optional)  model for comprehensibility scoring (gremlins-drag --model)
  //   instructions              (optional)  extra guidance injected into the per-iteration refactoring prompt
  //   base_ref                  (optional)  git ref to check out for the isolated worktree (default: HEAD)
  //   estimates-per-survey      (optional)  number of LLM estimates per survey (default: 5)
  //
  // NOTE: the bootstrap source is named `drag-model` (not `model`) because `model`
  // collides with gremlins' own global --model flag.  Pass `--drag-model provider/model`
  // to forward a model spec to gremlins-drag.
  //
  // How it works:
  //   1. Baseline — run gremlins-drag once to capture the starting score.
  //   2. Loop (max 11 iterations), split into three stages:
  //      a. Plan — an agent inspects the latest drag reports, considers the
  //         drivers of the drag score and candidate strategies, and writes a
  //         concrete implementation plan.
  //      b. Implement — an agent applies the plan to the target.
  //      c. Evaluate — re-run gremlins-drag, compare before/after drag, write
  //         an evaluation report, and bail if the iteration made no progress.
  //   3. Land — merge the worktree back into the main branch (manual via
  //      `gremlins land`).
  bootstrap: {
    source: {
      target: {
        type: "string",
      },
      "drag-model": {
        type: "string",
        optional: true,
      },
      instructions: {
        type: "string",
        optional: true,
      },
      base_ref: {
        type: "string",
        optional: true,
      },
      "estimates-per-survey": {
        type: "string",
        optional: true,
        default: "5",
      },
      p: {
        type: "string",
        optional: true,
      },
      "skip-maintainability": {
        type: "string",
        optional: true,
      },
    },
    launch_cmds: [
      'printf "%s" {target} > "$GREMLINS_STATE_DIR/artifacts/target.txt"',
      'printf "%s" {drag-model} > "$GREMLINS_STATE_DIR/artifacts/drag_model.txt"',
      'printf "%s" {instructions} > "$GREMLINS_STATE_DIR/artifacts/instructions.txt"',
      'printf "%s" {estimates-per-survey} > "$GREMLINS_STATE_DIR/artifacts/comp_estimates.txt"',
      'printf "%s" {p} > "$GREMLINS_STATE_DIR/artifacts/p.txt"',
      'printf "%s" {skip-maintainability} > "$GREMLINS_STATE_DIR/artifacts/skip_maint.txt"',
      'BASE_REF={base_ref} && SHA=$(git -C "$GREMLINS_PROJECT_ROOT" rev-parse --verify "${BASE_REF:-HEAD}") && git -C "$GREMLINS_PROJECT_ROOT" worktree add --detach "$GREMLIN_WORKDIR" "$SHA" && printf "%s" "$SHA" > "$GREMLINS_STATE_DIR/artifacts/base_sha"',
    ],
    cli_out: {
      target: "artifact://target.txt",
      drag_model: "artifact://drag_model.txt",
      instructions: "artifact://instructions.txt",
      base_sha: "artifact://base_sha",
      estimates_per_survey: "artifact://comp_estimates.txt",
      p: "artifact://p.txt",
      skip_maintainability: "artifact://skip_maint.txt",
    },
    env: "export GREMLINS_OPENAI_AGENTS_MAX_TURNS='1000'\nTHE_ENV=\"${GREMLINS_PROJECT_ROOT}/.gremlins/env\"\nif [ -f \"$THE_ENV\" ]; then\n    source \"$THE_ENV\"\nfi\nexport PATH=\"${GREMLINS_PROJECT_ROOT}/.gremlins/bin:${PATH}\"\n# Build GREMLINS_DRAG_CLI_CONFIG so that EVERY invocation of gremlins-drag\n# — both the deterministic pipeline stages AND the agent when it\n# self-assesses — uses identical parameters. The env var locks the\n# config: when set, gremlins-drag rejects all CLI arguments.\n#\n# Source values are available as GREMLINS_SOURCE_<KEY> env vars\n# (injected by resolve_env before this script is sourced), so we can\n# compute the config directly without depending on artifact files that\n# launch_cmds hasn't created yet.\nexport GREMLINS_DRAG_CLI_CONFIG=$(jq -cn '\n{\n  path: (env.GREMLINS_SOURCE_TARGET // \"\")\n} |\nif (env.GREMLINS_SOURCE_DRAG_MODEL? // \"\") != \"\" then\n  . + {model: env.GREMLINS_SOURCE_DRAG_MODEL}\nelse . end |\n. + {estimates_per_survey: ((env.GREMLINS_SOURCE_ESTIMATES_PER_SURVEY? // "5") | tonumber)} |\nif (env.GREMLINS_SOURCE_P? // \"\") != \"\" then\n  . + {p: env.GREMLINS_SOURCE_P | tonumber}\nelse . end |\nif (env.GREMLINS_SOURCE_SKIP_MAINTAINABILITY? // \"\") != \"\" and env.GREMLINS_SOURCE_SKIP_MAINTAINABILITY != \"false\" then\n  . + {skip_maintainability: true}\nelse . end\n')\n",
  },
  stages: [
    // ── baseline ──────────────────────────────────────────────────────────
    {
      name: "baseline",
      type: "exec",
      interpolation: {
        outputs: {
          report: "artifact://baseline/report.json",
          drag_best: "artifact://drag_best.txt",
        },
      },
      options: {
        cmds: [
          "gremlins-drag > {report}",
          'cp {report} "$GREMLINS_STATE_DIR/drag_current.json"',
          "cat {report} | jq 'if .packages then [.packages[].drag] | add else [.modules[].drag] | add end' > {drag_best}\n",
          'echo "baseline sum drag = $(cat {drag_best})"',
        ],
      },
    },
    // ── drag model explanation (formula, surveys, curves) ────────────────
    {
      name: "explain",
      type: "exec",
      interpolation: {
        inputs: {
          p: 'content("artifact://p.txt")',
        },
        outputs: {
          explain: "artifact://explain.txt",
        },
      },
      options: {
        cmds: [
          'P_ARG=""\n[ -n "{p}" ] && P_ARG="--p {p}"\n( unset GREMLINS_DRAG_CLI_CONFIG; gremlins-drag --explain $P_ARG > {explain})\n',
        ],
      },
    },
    // ── optimize loop ─────────────────────────────────────────────────────
    // Each iteration runs plan → implement → evaluate. The exec stages around
    // those three (context prep, cleanup, commit, progress guard, scoring) are
    // plumbing that keeps the worktree, artifacts, and state files consistent.
    {
      name: "optimize",
      type: "sequence",
      "max-iterations": 11,
      body: [
        // --- prepare the drag context (current + previous reports) ---
        {
          name: "prepare-context",
          type: "exec",
          interpolation: {
            outputs: {
              context: "artifact://{loop_iter}/drag_context.md",
            },
          },
          options: {
            cmds: [
              'STATE_DIR="$GREMLINS_STATE_DIR"\n{\n  if [ -f "$STATE_DIR/drag_previous.json" ]; then\n    echo "## Drag report before the last refactor (previous state)"\n    echo \'```json\'\n    cat "$STATE_DIR/drag_previous.json"\n    echo \'```\'\n    echo ""\n  fi\n  echo "## Drag report after the last refactor (current state)"\n  echo \'```json\'\n  cat "$STATE_DIR/drag_current.json"\n  echo \'```\'\n} > {context}\n',
            ],
          },
        },
        // --- plan: choose a strategy and write an implementation plan ---
        {
          name: "drag-optimize-plan",
          type: "agent",
          interpolation: {
            inputs: {
              target: 'content("artifact://target.txt")',
              drag_context: 'content("artifact://{loop_iter}/drag_context.md")',
              instructions: 'content("artifact://instructions.txt")',
              explain: 'content("artifact://explain.txt")',
            },
            outputs: {
              plan: "artifact://{loop_iter}/plan.md",
            },
          },
          prompt: [
            'You are planning a refactor of the target at {target} to reduce its drag score.\n\n**Your overriding goal is simple, beautiful, correct code.** Drag is the\nmetric, but genuine maintainability is the objective. The best refactorings\nare often the hardest — restructuring module boundaries, untangling\ncontrol flow, redesigning abstractions. Do not reach for the easy change\nwhen the right change is within reach. Effort spent now on quality means\nfar less maintenance burden later.\n\nThe reports below are the most recent drag analyses. The "current\nstate" report describes the code you are about to change. When a\n"previous state" report is present, it describes the code before the\nlast refactor, so you can compare what changed and how drag moved.\n\n{drag_context}\n\n## Drag model (how drag is computed)\n\n{explain}\n\n## How refactoring moves affect the score\n\n### token_count\nReducing a module\'s own token count directly lowers its footprint\n(since footprint includes the module itself) and may also reduce\nfootprints of upstream modules that transitively depend on it.\nSmaller total code means less surface area for bugs and lower\ncognitive load. However, token_count alone is a small part of the\ntotal drag: the comprehensibility and package-maintainability\nmultipliers can each amplify drag by up to ~12× (when m=2.5 or\np=2.5). The footprint multiplier (1+footprint)^w2 is unbounded.\n\n### footprint\nA module\'s footprint is the token sum of everything it transitively\ndepends on. Breaking deep dependency chains, inlining small\nsingle-use helpers back into their callers, and avoiding unnecessary\ncross-module couplings all reduce footprint. When a module is\nrefactored to depend on fewer other modules, its footprint\nshrinks — and every upstream module that depends on it may also\nbenefit. Footprint enters the formula as (1+footprint)^w2; larger\nfootprints amplify drag sub-linearly (w2=0.5 gives square-root\ngrowth).\n\n### comprehensibility\nComprehensibility is a multiplier on the footprint term:\nexp(m·(1−comp)). The survey and its seven dimensions (naming,\ncontrol_flow, data_flow, abstractions, cohesion, sizing,\ntest_hygiene) are described in the drag model above. To raise\ncomprehensibility, target the dimensions dragging a module\'s score\ndown: split dumping-ground files by concern (cohesion), break up\nmega-functions (sizing), and relocate inline tests out of the\nproduction file (test_hygiene), alongside naming, control-flow,\ndata-flow, and abstraction improvements. The effect is\nmultiplicative with footprint, so improving comprehensibility on\na high-footprint module yields more drag reduction than on a\nlow-footprint one.\n\n### package maintainability (only when `maint_score` is present)\nPackage maintainability is scored on ten dimensions (each 0–4),\nnormalized over 40 points; the dimensions and their anchors are\ndescribed in the drag model above. The package multiplier\nexp(p·(1−maint)) amplifies the sum of module drags within that\npackage; low maintainability can increase effective drag by up to\nexp(p). Improving any of the ten dimensions — extracting duplicated\nlogic into shared helpers, isolating changes to fewer files,\ntightening cross-module interfaces, flattening deep transitive\nchains, reducing public API surface, or sealing abstraction\nboundaries — raises maint_score and shrinks the package multiplier.\n\n## Splitting vs merging modules\n\nSplitting one module into two can increase or decrease total drag\ndepending on how the split affects each factor:\n\n- **token_count**: Splitting redistributes tokens across modules.\n  Total token_count across the package may stay roughly the same\n  (modulo any new imports, re-exports, or glue code).\n- **footprint**: Each half may still carry the same shared\n  transitive dependencies. If module A imports module B, A\'s\n  footprint includes B\'s tokens plus everything B depends on —\n  so splitting can increase the sum of footprints even when total\n  tokens are unchanged.\n- **comprehensibility**: Smaller, focused modules may be easier\n  to understand (raising comp). Conversely, fragmentation across\n  many files can obscure the overall design and force readers to\n  jump between files (lowering comp). The net effect depends on\n  whether the split creates clean conceptual boundaries or scatters\n  related logic.\n- **package maintainability** (when packages are present): More\n  modules may affect decomposition, change isolation, and\n  duplication scores. A split that creates clean, independent\n  boundaries can improve these dimensions. A split that scatters\n  related logic across files can hurt them. When no packages are\n  scored, this dimension does not apply.\n\nExample — splitting one module into two when both still share the\nsame transitive dependencies:\n\nOne module (2000 tokens, footprint 5000, comp 0.5, w2=0.5, m=2.5):\n  drag = (1+5000)^0.5 · exp(2.5·0.5) ≈ 70.7 · 3.49 ≈ 246.8\n\nSplit into A (1000 tokens) and B (1000 tokens), where A depends on B\nand both depend on shared downstream modules (3000 tokens beyond\nA/B themselves):\n  drag(A) = (1+5000)^0.5 · exp(2.5·0.5) ≈ 70.7 · 3.49 ≈ 246.8\n  drag(B) = (1+4000)^0.5 · exp(2.5·0.5) ≈ 63.3 · 3.49 ≈ 220.8\n  total ≈ 467.6\n\nHere splitting increased total drag because both halves still carry\nthe shared footprint. The outcome can differ when a split severs\nreal dependency edges (reducing actual transitive reach) or when\ncomprehensibility improves enough to offset the footprint penalty.\n\nMerging two modules reverses the analysis: footprint may decrease\n(fewer module-to-module edges), but comprehensibility may suffer if\nthe result is a large, unfocused file. When packages are present,\nthe net effect on package maintainability dimensions depends on\nwhether the merge consolidates related logic or creates a monolithic\nblob. When no packages are scored, this dimension does not apply.\n\n## Your job\n\n- Consider the drivers of the drag score in the current state and\n  identify the highest-leverage changes.\n- Consider multiple strategies — footprint reduction,\n  comprehensibility improvements, package-maintainability\n  improvements, and splitting vs merging modules — and choose the\n  one most likely to reduce total drag.\n- **Prioritize correctness and code quality above all else.**\n  The goal is simple, beautiful, correct code. Do not shy away\n  from difficult refactorings — effort spent now to improve the\n  codebase means much less maintenance effort in the future.\n  Prefer the change that makes the code genuinely better, even\n  when it requires more work: restructuring module boundaries,\n  untangling complex control flow, redesigning abstractions,\n  flattening deep dependency chains, or consolidating scattered\n  logic into coherent modules.\n- **Test code does not count toward token_count or footprint.**\n  `gremlins-drag` strips `#[cfg(test)]` items before counting\n  tokens, so moving test code never changes the footprint term.\n  Test_hygiene is the **least impactful** of the seven\n  comprehensibility dimensions — it can raise comp by at most a\n  few hundredths, which is negligible compared to footprint\n  reduction or improvements to sizing/cohesion/control-flow.\n- **A `mod tests` block already cleanly separated at the bottom\n  of a file is good test_hygiene.** Do not mechanically extract\n  these blocks into separate test files — it creates git churn\n  for zero measurable drag benefit.\n- Only consider test relocation when tests are genuinely\n  **interleaved with production code** in the same file (e.g.,\n  helper functions immediately followed by their unit tests).\n  Even then, treat it as a side effect of restructuring\n  production code, never as a standalone plan item.\n- **Test-only changes do not count as progress.** A plan whose\n  primary effect is test reorganization will be rolled back.\n- Write a concrete, ordered implementation plan. For each step, name\n  the file(s), describe the specific change, and explain why it\n  should reduce drag.\n- Size the plan to the problem, not to an arbitrary limit. If the\n  right fix touches many files and restructures module boundaries,\n  that is fine — describe every step needed for a complete,\n  correct implementation. The only constraint: the plan must be\n  completable in a single pass without bailing for help.\n- Do NOT edit any source files in this stage. Only write the plan.\n\nWrite the plan to `{plan}`.\n\n## Additional guidance\n{instructions}\n',
          ],
          //# Your job
          //# Additional guidance
          options: {
            idle_timeout: 600,
          },
        },
        // --- implement: apply the plan to the target ---
        {
          name: "drag-optimize-implement",
          type: "agent",
          interpolation: {
            inputs: {
              target: 'content("artifact://target.txt")',
              plan: 'content("artifact://{loop_iter}/plan.md")',
              drag_context: 'content("artifact://{loop_iter}/drag_context.md")',
              instructions: 'content("artifact://instructions.txt")',
            },
            outputs: {
              summary: "artifact://{loop_iter}/summary.md",
            },
          },
          prompt: [
            'Implement the refactoring plan below for the target at {target} to reduce its drag score.\n\n**Your overriding goal is simple, beautiful, correct code.** Do not cut\ncorners or settle for a partial implementation. If the plan calls for deep\nrestructuring, carry it through completely. The metric is drag, but the\nobjective is genuine maintainability — code that future developers will\nthank you for. Hard work now compounds into less work later.\n\n## Plan\n\n{plan}\n\n## Current drag state (for reference)\n\n{drag_context}\n\n## Rules\n- Follow the plan. If you discover a better approach mid-implementation,\n  prefer the plan unless it is clearly wrong; note any deviation in your summary.\n- **Strive for simple, beautiful, correct code.** Do not take shortcuts\n  or settle for a partial fix when the plan calls for deeper restructuring.\n  Difficult changes — redesigning module boundaries, flattening dependency\n  chains, untangling control flow — are worth the effort. Correctness and\n  clarity today mean far less maintenance burden tomorrow.\n- Do NOT break correctness. After changes, verify the code still\n  compiles / runs / imports cleanly (use whatever toolchain is available:\n  `cargo check`, `python3 -m py_compile`, etc.).\n- Run tests if a test runner is available.\n- If no safe refactoring can reduce drag, say so clearly and explain why.\n- **Test code does not count toward token_count or footprint.**\n  `gremlins-drag` strips `#[cfg(test)]` modules from Rust source\n  files before counting tokens, so test code has zero effect on the\n  footprint term. Do not reorganize test code that is already in a\n  clean `mod tests` block at the bottom of a file.\n- The plan you are implementing should contain no test-only\n  changes. If the plan includes mechanical test extraction, note\n  in your summary that you skipped it and explain why.\n- Write a concise summary of what you changed (or why you couldn\'t) to\n  `{summary}`.\n\n## Additional guidance\n{instructions}\n',
          ],
          //# Rules
          //# Additional guidance
          options: {
            idle_timeout: 600,
          },
        },
        {
          name: "cleanup-build-artifacts",
          type: "exec",
          options: {
            cmds: [
              "cargo clean 2>/dev/null || true",
              "find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true",
              "find . -type f -name '*.pyc' -delete 2>/dev/null || true",
            ],
          },
        },
        {
          name: "commit",
          type: "exec",
          options: {
            cmds: [
              "git add -A",
              "git diff --cached --quiet || git commit -m 'refactor: reduce drag (iter {loop_iter})'\n",
            ],
          },
        },
        {
          name: "require-progress",
          type: "exec",
          interpolation: {
            inputs: {
              base_sha: 'content("artifact://base_sha")',
            },
          },
          options: {
            cmds: [
              'git merge-base --is-ancestor "{base_sha}" HEAD',
              'test `git rev-list --count "{base_sha}..HEAD"` -gt 0',
            ],
          },
        },
        // --- score: re-measure drag and rotate state for the next iteration ---
        {
          name: "score",
          type: "exec",
          interpolation: {
            outputs: {
              report: "artifact://{loop_iter}/report.json",
              drag_before: "artifact://{loop_iter}/drag_before.txt",
              drag_after: "artifact://{loop_iter}/drag_after.txt",
              iter_sha: "artifact://{loop_iter}/iter_sha.txt",
            },
          },
          options: {
            cmds: [
              'git -C "$GREMLIN_WORKDIR" rev-parse HEAD > "$GREMLINS_STATE_DIR/artifacts/{loop_iter}/iter_sha.txt"',
              "gremlins-drag > {report}",
              'STATE_DIR="$GREMLINS_STATE_DIR"\ndrag_sum() {\n  jq \'if .packages then [.packages[].drag] | add else [.modules[].drag] | add end\' < "$1"\n}\nif [ -f "$STATE_DIR/drag_current.json" ]; then\n  drag_sum "$STATE_DIR/drag_current.json" > {drag_before}\n  cp "$STATE_DIR/drag_current.json" "$STATE_DIR/drag_previous.json"\nelse\n  printf "0" > {drag_before}\nfi\ncp {report} "$STATE_DIR/drag_current.json"\n',
              'STATE_DIR="$GREMLINS_STATE_DIR"\ndrag_sum() {\n  jq \'if .packages then [.packages[].drag] | add else [.modules[].drag] | add end\' < "$1"\n}\nAFTER=$(drag_sum "$STATE_DIR/drag_current.json")\nprintf "%s" "$AFTER" > {drag_after}\nBEST=$(cat "$GREMLINS_STATE_DIR/artifacts/drag_best.txt" 2>/dev/null)\nif ! awk -v a="$AFTER" -v b="$BEST" \'BEGIN { exit (b < a) ? 0 : 1 }\' 2>/dev/null; then\n  BEST="$AFTER"\nfi\nprintf "%s" "$BEST" > "$GREMLINS_STATE_DIR/artifacts/drag_best.txt"\necho "iteration {loop_iter} drag = $AFTER (best = $BEST)"\n',
            ],
          },
        },
        // --- evaluate: agent judges legitimacy, rolls back gaming, bails on no progress ---
        // `drag_reduced` is a required output — only written for legitimate,
        // drag-reducing iterations. Missing → bail for operator review.
        {
          name: "drag-optimize-evaluate",
          type: "agent",
          interpolation: {
            inputs: {
              target: 'content("artifact://target.txt")',
              plan: 'content("artifact://{loop_iter}/plan.md")',
              summary: 'content("artifact://{loop_iter}/summary.md")',
              drag_before: 'content("artifact://{loop_iter}/drag_before.txt")',
              drag_after: 'content("artifact://{loop_iter}/drag_after.txt")',
              iter_sha: 'content("artifact://{loop_iter}/iter_sha.txt")',
            },
            outputs: {
              drag_reduced: "artifact://{loop_iter}/drag_reduced.txt",
            },
          },
          prompt: [
            'Evaluate the just-completed refactoring iteration for {target}.\n\n## Drag scores\n\n- Before: {drag_before}\n- After: {drag_after}\n\n## The plan\n\n{plan}\n\n## What the implementer reported\n\n{summary}\n\n## Your job\n\nRun read-only git commands (`git diff {iter_sha}`, `git log`, `git show`)\nto inspect exactly what changed. Then answer this\nquestion:\n\n**Did this iteration genuinely improve maintainability, or did it\ngame the drag score?**\n\nRemember: the goal is simple, beautiful, correct code. Drag measures\nit, but genuine structural improvement is what counts. An ambitious\nrefactoring that meaningfully simplifies the codebase is success —\neven if the drag reduction is modest. Conversely, a cheap change that\nnudges the score without making the code better is failure.\n\n### Score gaming\n\nScore gaming means changes whose primary effect is to manipulate the\ndrag formula without genuinely making the code easier to understand,\nmodify, or maintain. Use your judgment — don\'t pattern-match.\nExamples (not an exhaustive list):\n\n- Cosmetic-only changes: renames without clarity gain, reordering\n  without structural benefit, whitespace-only changes\n- Splitting files without reducing actual coupling\n- Adding indirection that obscures rather than clarifies\n- Mechanically extracting `#[cfg(test)] mod tests` blocks that are\n  already cleanly separated at the bottom of a production file into\n  separate test files — this is pure churn with zero hygiene gain\n  (the tests were already out of the production code path)\n- Moving, splitting, or reorganizing test code without improving\n  test_hygiene — e.g. renaming test files, reordering test functions,\n  or shuffling test modules between directories\n- Deleting or weakening tests to shrink a file (breaks correctness\n  guarantee; also pointless for drag since tests are stripped from\n  token counts)\n\n### Legitimate refactoring\n\nLegitimate changes make the code genuinely easier to maintain:\nsimpler control flow, reduced coupling, better abstractions, less\nduplication, tighter APIs, clearer names, flatter dependency chains,\nsplitting dumping-ground files by concern, breaking up mega-functions,\nand relocating tests that are genuinely interleaved with production\ncode (not already in a clean bottom-of-file `mod tests` block). The\ndiff should show meaningful structural improvement — not just\nrearranging deck chairs.\n\n**Scope is not a signal of gaming.** A refactoring that touches many\nfiles to restructure module boundaries, untangle complex coupling, or\nredesign abstractions can be entirely legitimate. Judge the quality of\nthe changes, not the size of the diff. Large, careful restructurings\nthat genuinely simplify the codebase are exactly what we want.\n\n### Your verdict\n\nWrite ONLY one word — your verdict — to `{drag_reduced}`. You MAY run\nread-only git commands (`git diff`, `git log`, `git show`) to inspect\nchanges. Do NOT run mutating git commands (commit, reset, branch,\netc.) and do NOT modify any files. Only write the verdict to\n`{drag_reduced}`. An exec stage after this one will\nhandle rollback if needed.\n\n**Legitimate AND drag improved (after < before):**\nWrite `reduced`. The iteration succeeded.\n\n**Legitimate BUT drag did not improve:**\nDo NOT write `{drag_reduced}`. The pipeline will bail for operator\nreview.\n\n**Score gaming:**\nWrite `rolled_back`. An exec stage will undo the commit and repair\nthe state files. Explain clearly what gaming pattern you detected.\n\nSummary:\n- Write `reduced` → drag improved, loop continues.\n- Write `rolled_back` → gaming, loop continues after exec rollback.\n- Write nothing → no progress, bail for operator review.\n',
          //# Your job
          //# Your verdict
          options: {
            idle_timeout: 600,
          },
        },
        // --- rollback: deterministic exec that handles the evaluate verdict ---
        {
          name: "rollback",
          type: "exec",
          interpolation: {
            inputs: {
              verdict: 'content("artifact://{loop_iter}/drag_reduced.txt")',
              iter_sha: 'content("artifact://{loop_iter}/iter_sha.txt")',
            },
          },
          options: {
            cmds: [
              'if [ "{verdict}" = "rolled_back" ]; then\n  echo "rolling back iteration {loop_iter} (gaming detected)"\n  git -C "$GREMLIN_WORKDIR" reset --hard {iter_sha}\n  if [ -f "$GREMLINS_STATE_DIR/drag_previous.json" ]; then\n    cp "$GREMLINS_STATE_DIR/drag_previous.json" "$GREMLINS_STATE_DIR/drag_current.json"\n    DRAG_BEFORE=$(cat "$GREMLINS_STATE_DIR/artifacts/{loop_iter}/drag_before.txt" 2>/dev/null)\n    printf "%s" "${DRAG_BEFORE:-0}" > "$GREMLINS_STATE_DIR/artifacts/drag_best.txt"\n    echo "restored drag_best to pre-iteration value"\n  fi\nelif [ "{verdict}" = "reduced" ]; then\n  echo "iteration {loop_iter} is legitimate with drag improvement"\nelse\n  echo "iteration {loop_iter} verdict is unknown: {verdict}"\nfi\n',
            ],
          },
        },      ],
    },
    // ── commit message ────────────────────────────────────────────────────
    {
      name: "commit-message",
      type: "exec",
      interpolation: {
        inputs: {
          target: 'content("artifact://target.txt")',
          baseline_report: "artifact://baseline/report.json",
          drag_best_val: 'content("artifact://drag_best.txt")',
        },
        outputs: {
          commit_message: "artifact://commit_message.txt",
        },
      },
      options: {
        cmds: [
          'BEST="{drag_best_val}"\n[ -z "$BEST" ] && BEST="N/A"\nBASE_SUM=$(jq \'if .packages then ([.packages[].drag] | add | . * 100 | round) / 100 else ([.modules[].drag] | add | . * 100 | round) / 100 end\' < {baseline_report})\n{\n  echo "drag-optimizer: reduce drag for {target}"\n  echo ""\n  echo "Baseline drag sum: $BASE_SUM \u2192 Best: $BEST"\n  echo "Target: {target}"\n} > {commit_message}\n',
        ],
      },
    },
  ],
  land: {
    interpolation: {
      inputs: {
        message: "artifact://commit_message.txt",
      },
    },
    land_cmds: [
      'WORKTREE_HEAD=$(git -C "$GREMLIN_WORKDIR" rev-parse HEAD)',
      'git merge --squash "$WORKTREE_HEAD"',
      'git diff --cached --quiet || git commit -F "{message}"',
    ],
    clean_cmds: [
      'git worktree remove --force "$GREMLIN_WORKDIR" || true',
      "git worktree prune",
    ],
  },
}
