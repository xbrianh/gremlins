{
  // Drag score optimizer — iterative refactoring loop driven by gremlins-drag.
  //
  // Usage:
  //   gremlins launch drag-optimizer --target crates/gremlins/src/lib.rs
  //   gremlins launch drag-optimizer --target src/ --drag-model openai/gpt-4o
  //   gremlins launch drag-optimizer --target my_pkg/ --instructions "focus on cyclomatic complexity"
  //
  // Parameters (launch-time):
  //   target                    (required)  module file or package directory to refactor
  //   drag-model                (optional)  model for comprehensibility scoring (gremlins-drag --model)
  //   instructions              (optional)  extra guidance injected into the per-iteration refactoring prompt
  //   base_ref                  (optional)  git ref to check out for the isolated worktree (default: HEAD)
  //   comprehensibility-estimates (optional)  number of LLM estimates per module (default: 5)
  //
  // NOTE: the bootstrap source is named `drag-model` (not `model`) because `model`
  // collides with gremlins' own global --model flag.  Pass `--drag-model provider/model`
  // to forward a model spec to gremlins-drag.
  //
  // How it works:
  //   1. Baseline — run gremlins-drag once to capture the starting score.
  //   2. Loop (max 5 iterations):
  //      a. Refactor — an agent stage inspects the latest drag report (and,
  //         from iteration 2 on, the report from before the last attempt)
  //         and edits the target to reduce drag.
  //      b. Commit — git add + commit in the isolated worktree.
  //      c. Score + converge — run gremlins-drag on the refactored code.  If
  //         the max ln_drag did not improve, write a convergence marker
  //         (stopping the loop early).  Otherwise update the tracking best.
  //   3. Land — merge the worktree back into the main branch (manual via
  //      `gremlins land`).
  bootstrap: {
    source: {
      target: {
        type: "string",
      },
      "drag-model": {
        type: "string",
        optional: true,
      },
      instructions: {
        type: "string",
        optional: true,
      },
      base_ref: {
        type: "string",
        optional: true,
      },
      "comprehensibility-estimates": {
        type: "string",
        optional: true,
      },
    },
    launch_cmds: [
      'printf "%s" {target} > "$GREMLINS_STATE_DIR/artifacts/target.txt"',
      'printf "%s" {drag-model} > "$GREMLINS_STATE_DIR/artifacts/drag_model.txt"',
      'printf "%s" {instructions} > "$GREMLINS_STATE_DIR/artifacts/instructions.txt"',
      'printf "%s" {comprehensibility-estimates} > "$GREMLINS_STATE_DIR/artifacts/comp_estimates.txt"',
      'BASE_REF={base_ref} && SHA=$(git -C "$GREMLINS_PROJECT_ROOT" rev-parse --verify "${BASE_REF:-HEAD}") && git -C "$GREMLINS_PROJECT_ROOT" worktree add --detach "$GREMLIN_WORKDIR" "$SHA" && printf "%s" "$SHA" > "$GREMLINS_STATE_DIR/artifacts/base_sha"',
    ],
    cli_out: {
      target: "artifact://target.txt",
      drag_model: "artifact://drag_model.txt",
      instructions: "artifact://instructions.txt",
      base_sha: "artifact://base_sha",
      comprehensibility_estimates: "artifact://comp_estimates.txt",
    },
    env: 'export GREMLINS_OPENAI_AGENTS_MAX_TURNS=\'1000\'\nTHE_ENV="${GREMLINS_PROJECT_ROOT}/.gremlins/env"\nif [ -f "$THE_ENV" ]; then\n    source "$THE_ENV"\nfi\nexport PATH="${GREMLINS_PROJECT_ROOT}/.gremlins/bin:${PATH}"\n',
  },
  stages: [
    // ── baseline ──────────────────────────────────────────────────────────
    {
      name: "baseline",
      type: "exec",
      interpolation: {
        inputs: {
          target: 'content("artifact://target.txt")',
          drag_model: 'content("artifact://drag_model.txt")',
          comprehensibility_estimates: 'content("artifact://comp_estimates.txt")',
        },
        outputs: {
          report: "artifact://baseline/report.json",
          drag_best: "artifact://drag_best.txt",
        },
      },
      options: {
        cmds: [
          'MODEL_ARG=""\n[ -n "{drag_model}" ] && MODEL_ARG="--model {drag_model}"\nEST="{comprehensibility_estimates}"\n[ -z "$EST" ] && EST=5\ngremlins-drag --json --comprehensibility-estimates $EST {target} $MODEL_ARG > {report}\n',
          'cp {report} "$GREMLINS_STATE_DIR/drag_current.json"',
          'cat {report} | python3 -c \'import json,sys; data=json.load(sys.stdin); print(sum(m["ln_drag"] for m in data["modules"]))\' > {drag_best}\n',
          'echo "baseline sum ln_drag = $(cat {drag_best})"',
        ],
      },
    },
    // ── drag curves (generated from current weights) ─────────────────────
    {
      name: "curves",
      type: "exec",
      interpolation: {
        outputs: {
          curves: "artifact://curves.txt",
        },
      },
      options: {
        cmds: ["gremlins-drag --curves > {curves}"],
      },
    },
    // ── optimize loop ─────────────────────────────────────────────────────
    {
      name: "optimize",
      type: "sequence",
      "max-iterations": 5,
      skip_if_exists: "artifact://{loop_iter}/converged",
      body: [
        // --- prepare refactor context (latest report + previous, when available) ---
        {
          name: "prepare-refactor-context",
          type: "exec",
          interpolation: {
            outputs: {
              context: "artifact://{loop_iter}/refactor_context.md",
            },
          },
          options: {
            cmds: [
              'STATE_DIR="$GREMLINS_STATE_DIR"\n{\n  if [ -f "$STATE_DIR/drag_previous.json" ]; then\n    echo "## Drag report before the last refactor (previous state)"\n    echo \'```json\'\n    cat "$STATE_DIR/drag_previous.json"\n    echo \'```\'\n    echo ""\n  fi\n  echo "## Drag report after the last refactor (current state)"\n  echo \'```json\'\n  cat "$STATE_DIR/drag_current.json"\n  echo \'```\'\n} > {context}\n',
            ],
          },
        },
        // --- refactor ---
        {
          name: "refactor",
          type: "agent",
          interpolation: {
            inputs: {
              target: 'content("artifact://target.txt")',
              drag_context: 'content("artifact://{loop_iter}/refactor_context.md")',
              instructions: 'content("artifact://instructions.txt")',
              curves: 'content("artifact://curves.txt")',
            },
            outputs: {
              summary: "artifact://{loop_iter}/summary.md",
            },
          },
          prompt: [
            'Refactor the target at {target} to reduce its drag score.\n\nThe reports below are the most recent drag analyses. The "current\nstate" report describes the code you are about to edit. When a\n"previous state" report is present, it describes the code before the\nlast refactor, so you can compare what changed and how drag moved.\n\n{drag_context}\n\n## What drag means\nln_drag = w1*ln(token_count) + w2*ln(graph_complexity) − w4*ln(1 + consumers) − w3*ln(comprehensibility + ε)\n\nHigher drag = the module is harder to maintain and change. The optimizer\nminimizes the **sum** of ln_drag across all scored modules — not any\nsingle module in isolation.\n\n## Drag curves (how each term responds to change)\n\n{curves}\n\n## Strategy\n1. **Reduce token_count** — extract helpers, deduplicate, trim boilerplate,\n   remove dead code. This is the largest absolute contributor.\n2. **Lower graph_complexity** — flatten deep nesting, decouple cross-cutting\n   concerns, reduce fan-in/fan-out.\n3. **Increase consumers** — modules depended on by many others are carrying\n   their weight. Inlining a module with few consumers into its sole\n   consumer removes a low-value boundary and reduces total drag.\n4. **Improve comprehensibility** — clearer names, simpler control flow,\n   better documentation where it aids understanding. Highest leverage\n   per unit of change with w3=3.0.\n\n### Splitting trap (CRITICAL)\nSplitting one module into two INCREASES total drag unless the new\nmodules gain significant consumers or comprehensibility improves\nenough to compensate:\n\nOne module (2000 tokens, complexity 50, 3 consumers, comp 0.5):\n  ln_drag = 7.60 + 7.82 − 2.77 + 2.02 = 14.67\n\nTwo modules (1000 tokens each, same complexity, 0 consumers, same comp):\n  ln_drag = (6.91 + 7.82 − 0.00 + 2.02) + (6.91 + 7.82 − 0.00 + 2.02) = 33.50\n\n→ Splitting more than DOUBLED drag! Only split if the resulting modules\n  gain consumers or are significantly simpler (lower complexity) or\n  more comprehensible. Prefer inlining, deduplication, and dead-code\n  removal over splitting.\n\n## Rules\n- Do NOT break correctness. After changes, verify the code still\n  compiles / runs / imports cleanly (use whatever toolchain is available:\n  `cargo check`, `python3 -m py_compile`, etc.).\n- Run tests if a test runner is available.\n- If no safe refactoring can reduce drag, say so clearly and explain why.\n- **Tests and drag:** `gremlins-drag` reads entire source files — it does\n  NOT strip `#[cfg(test)]` modules or `tests/` directories. Every `.rs`\n  file found under the target directory contributes tokens, fan-in/out,\n  and comprehensibility. Moving tests out of a Rust module (e.g. from a\n  `#[cfg(test)] mod tests` block into `tests/foo_test.rs`) does NOT\n  reduce drag — it just redistributes it to another scored module.\n  Removing or weakening tests that provide real coverage constitutes\n  breaking correctness and is not allowed.\n- Write a concise summary of what you changed (or why you couldn\'t) to\n  `{summary}`.\n\n## Additional guidance\n{instructions}\n',
          ],
          //# What drag means
          //# Drag curves (how each term responds to change)
          //# Strategy
          //## Splitting trap (CRITICAL)
          //# Rules
          //# Additional guidance
          options: {
            idle_timeout: 600,
          },
        },
        {
          name: "cleanup-build-artifacts",
          type: "exec",
          options: {
            cmds: [
              "cargo clean 2>/dev/null || true",
              "find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true",
              "find . -type f -name '*.pyc' -delete 2>/dev/null || true",
            ],
          },
        },
        {
          name: "commit",
          type: "exec",
          options: {
            cmds: [
              "git add -A",
              "git diff --cached --quiet || git commit -m 'refactor: reduce drag (iter {loop_iter})'\n",
            ],
          },
        },
        {
          name: "require-progress",
          type: "exec",
          interpolation: {
            inputs: {
              base_sha: 'content("artifact://base_sha")',
            },
          },
          options: {
            cmds: [
              'git merge-base --is-ancestor "{base_sha}" HEAD',
              'test `git rev-list --count "{base_sha}..HEAD"` -gt 0',
            ],
          },
        },
        // --- score + convergence (after refactor, so the comparison is fair) ---
        {
          name: "score-converge",
          type: "exec",
          interpolation: {
            inputs: {
              target: 'content("artifact://target.txt")',
              drag_model: 'content("artifact://drag_model.txt")',
              comprehensibility_estimates: 'content("artifact://comp_estimates.txt")',
              drag_best_val: 'content("artifact://drag_best.txt")',
            },
            outputs: {
              report: "artifact://{loop_iter}/report.json",
              "converged?": "artifact://{loop_iter}/converged",
            },
          },
          options: {
            cmds: [
              'MODEL_ARG=""\n[ -n "{drag_model}" ] && MODEL_ARG="--model {drag_model}"\nEST="{comprehensibility_estimates}"\n[ -z "$EST" ] && EST=5\ngremlins-drag --json --comprehensibility-estimates $EST {target} $MODEL_ARG > {report}\n',
              'STATE_DIR="$GREMLINS_STATE_DIR"\nif [ -f "$STATE_DIR/drag_current.json" ]; then\n  cp "$STATE_DIR/drag_current.json" "$STATE_DIR/drag_previous.json"\nfi\ncp {report} "$STATE_DIR/drag_current.json"\n',
              'BEST="{drag_best_val}"\n[ -z "$BEST" ] && BEST=0\nCURR=$(cat {report} | python3 -c \'import json,sys; data=json.load(sys.stdin); print(sum(m["ln_drag"] for m in data["modules"]))\')\nif awk "BEGIN{exit !($CURR >= $BEST)}"; then\n  touch {converged}\n  echo "converged — drag $CURR >= best $BEST"\n  printf "%s" "$BEST" > "$GREMLINS_STATE_DIR/artifacts/drag_best.txt"\nelse\n  printf "%s" "$CURR" > "$GREMLINS_STATE_DIR/artifacts/drag_best.txt"\n  echo "improved — drag $CURR < $BEST (was $BEST)"\nfi\n',
            ],
          },
        },
      ],
    },
    // ── commit message ────────────────────────────────────────────────────
    {
      name: "commit-message",
      type: "exec",
      interpolation: {
        inputs: {
          target: 'content("artifact://target.txt")',
          baseline_report: "artifact://baseline/report.json",
          drag_best_val: 'content("artifact://drag_best.txt")',
        },
        outputs: {
          commit_message: "artifact://commit_message.txt",
        },
      },
      options: {
        cmds: [
          'BEST="{drag_best_val}"\n[ -z "$BEST" ] && BEST="N/A"\nBASE_SUM=$(python3 -c \'import json,sys; data=json.load(sys.stdin); print(round(sum(m["ln_drag"] for m in data["modules"]), 2))\' < {baseline_report})\n{\n  echo "drag-optimizer: reduce drag for {target}"\n  echo ""\n  echo "Baseline ln_drag sum: $BASE_SUM \\u2192 Best: $BEST"\n  echo "Target: {target}"\n} > {commit_message}\n',
        ],
      },
    },
  ],
  land: {
    interpolation: {
      inputs: {
        message: "artifact://commit_message.txt",
      },
    },
    land_cmds: [
      'WORKTREE_HEAD=$(git -C "$GREMLIN_WORKDIR" rev-parse HEAD)',
      'git merge --squash "$WORKTREE_HEAD"',
      'git diff --cached --quiet || git commit -F "{message}"',
    ],
    clean_cmds: [
      'git worktree remove --force "$GREMLIN_WORKDIR" || true',
      "git worktree prune",
    ],
  },
}
