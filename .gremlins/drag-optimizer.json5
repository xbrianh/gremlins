{
  prompt_dir: "prompts",
  // Drag score optimizer — single-pass refactoring driven by gremlins-drag.
  //
  // Usage:
  //   gremlins launch drag-optimizer --target crates/gremlins/src/lib.rs
  //   gremlins launch drag-optimizer --target src/ --drag-model openai/gpt-4o
  //   gremlins launch drag-optimizer --target my_pkg/ --instructions "focus on cyclomatic complexity"
  //   gremlins launch drag-optimizer --base_ref main
  //   gremlins launch drag-optimizer --base_ref main --instructions "focus on cyclomatic complexity"
  //   gremlins launch drag-optimizer --diff ../some-branch --instructions "focus on the diff"
  //
  // Parameters (launch-time):
  //   target                    (optional)  module file or package directory to refactor
  //                                         when omitted, detected from the diff between
  //                                         base_ref and the current branch HEAD
  //   drag-model                (optional)  model for comprehensibility scoring (gremlins-drag --model)
  //   instructions              (optional)  extra guidance injected into the refactoring prompt
  //   diff                      (optional)  path to a diff file (e.g. from another branch)
  //                                         injected into the planning prompt so the planner
  //                                         can focus on the changed code
  //   base_ref                  (optional)  git ref for diff comparison base (worktree always checks out HEAD; default: HEAD)
  //   estimates-per-survey      (optional)  number of LLM estimates per survey (default: 5)
  //
  // NOTE: the bootstrap source is named `drag-model` (not `model`) because `model`
  // collides with gremlins' own global --model flag.  Pass `--drag-model provider/model`
  // to forward a model spec to gremlins-drag.
  //
  // How it works (a single drag pass — detect, measure, plan, implement, measure):
  //   1. Detect target — if --target was provided, use it; otherwise auto-detect
  //      from the diff between base_ref and branch HEAD.
  //   2. Measure — run gremlins-drag once to capture the baseline score.
  //   3. Explain — capture the drag model explanation (formula, surveys, curves).
  //   4. Plan — an agent inspects the baseline drag report and writes a
  //      refactoring strategy targeting the drag drivers.
  //   5. Implement & QA — implement the plan, then verify, review, and
  //      address review feedback (delegates to implement-and-qa).
  //   6. Measure — re-run gremlins-drag and compare before/after drag.
  //   7. Land — merge the worktree back into the main branch (manual via
  //      `gremlins land`).
  bootstrap: {
    source: {
      target: {
        type: "string",
        optional: true,
      },
      "drag-model": {
        type: "string",
        optional: true,
      },
      instructions: {
        type: "string",
        optional: true,
      },
      diff: {
        type: "filepath",
        optional: true,
      },
      base_ref: {
        type: "string",
        optional: true,
      },
      "estimates-per-survey": {
        type: "string",
        optional: true,
        default: "5",
      },
      p: {
        type: "string",
        optional: true,
      },
      "skip-maintainability": {
        type: "string",
        optional: true,
      },
      "drag-config": {
        type: "filepath",
        optional: true,
      },
    },
    launch_cmds: [
      'printf "%s" {target} > "$GREMLINS_STATE_DIR/artifacts/target.txt"',
      'printf "%s" {drag-model} > "$GREMLINS_STATE_DIR/artifacts/drag_model.txt"',
      'printf "%s" {instructions} > "$GREMLINS_STATE_DIR/artifacts/instructions.txt"',
      'gremlins:bind_artifact("artifact://diff.txt", diff)',
      'printf "%s" {estimates-per-survey} > "$GREMLINS_STATE_DIR/artifacts/comp_estimates.txt"',
      'printf "%s" {p} > "$GREMLINS_STATE_DIR/artifacts/p.txt"',
      'printf "%s" {skip-maintainability} > "$GREMLINS_STATE_DIR/artifacts/skip_maint.txt"',
      'BASE_REF={base_ref} && BASE_SHA=$(git -C "$GREMLINS_PROJECT_ROOT" rev-parse --verify "${BASE_REF:-HEAD}") && HEAD_SHA=$(git -C "$GREMLINS_PROJECT_ROOT" rev-parse --verify HEAD) && git -C "$GREMLINS_PROJECT_ROOT" worktree add --detach "$GREMLIN_WORKDIR" "$HEAD_SHA" && printf "%s" "$BASE_SHA" > "$GREMLINS_STATE_DIR/artifacts/base_sha"',
      // Build the drag config JSON file.  Scoring parameters come from the
      // project config (or --drag-config override) with bootstrap overrides.
      // Written directly into artifacts/; GREMLINS_DRAG_CLI_CONFIG points to
      // it so gremlins-drag picks up scoring parameters.  Targets are passed
      // positionally on the gremlins-drag CLI by each drag stage.
      'DRAG_CONFIG_SRC={drag-config} DRAG_MODEL={drag-model} DRAG_ESTIMATES={estimates-per-survey} DRAG_P={p} DRAG_SKIP_MAINT={skip-maintainability} drag-bootstrap-config "$GREMLINS_STATE_DIR/artifacts/drag_config.json"',
    ],
    cli_out: {
      target: "artifact://target.txt",
      drag_model: "artifact://drag_model.txt",
      instructions: "artifact://instructions.txt",
      base_sha: "artifact://base_sha",
      drag_config: "artifact://drag_config.json",
      estimates_per_survey: "artifact://comp_estimates.txt",
      p: "artifact://p.txt",
      skip_maintainability: "artifact://skip_maint.txt",
    },
    env: "export GREMLINS_OPENAI_AGENTS_MAX_TURNS='1000'\nexport CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-${GREMLINS_PROJECT_ROOT}/.cargo-gremlin-target}\"\nexport CARGO_INCREMENTAL=0\nTHE_ENV=\"${GREMLINS_PROJECT_ROOT}/.gremlins/env\"\nif [ -f \"$THE_ENV\" ]; then\n    source \"$THE_ENV\"\nfi\nexport PATH=\"${GREMLINS_PROJECT_ROOT}/.gremlins/bin:${PATH}\"\nexport GREMLINS_DRAG_CLI_CONFIG=\"$GREMLINS_STATE_DIR/artifacts/drag_config.json\"\n# GREMLINS_DRAG_CLI_CONFIG points to the frozen drag config artifact for\n# scoring parameters.  Targets are passed positionally on every call.",
  },
  stages: [
    // ── detect the drag target (explicit --target, or diff-derived) ─────
    {
      name: "detect-target",
      type: "exec",
      interpolation: {
        inputs: {
          base_sha: 'content("artifact://base_sha")',
          explicit_target: 'content("artifact://target.txt")',
        },
        outputs: {
          target: "artifact://drag/target.txt",
          drag_base_sha: "artifact://drag/drag_base_sha.txt",
        },
      },
      options: {
        cmds: [
          // Capture the commit before drag changes start.
          'git -C "$GREMLIN_WORKDIR" rev-parse HEAD | tr -d \'\\n\' > {drag_base_sha}',
          // If --target was supplied, use it.  Otherwise auto-detect from the
          // diff between base_ref and the current branch HEAD.
          'EXPLICIT="{explicit_target}"\nif [ -n "$EXPLICIT" ]; then\n  echo "using explicit target: $EXPLICIT"\n  printf "%s" "$EXPLICIT" > "{target}"\nelse\n  BASE_SHA="{base_sha}"\n  CHANGED_FILES=()\n  while IFS= read -r -d \'\' f; do CHANGED_FILES+=("$f"); done < <(git -C "$GREMLINS_PROJECT_ROOT" diff "$BASE_SHA...HEAD" --name-only -z -- \'*.rs\')\n  if [ ${#CHANGED_FILES[@]} -eq 0 ]; then\n    while IFS= read -r -d \'\' f; do CHANGED_FILES+=("$f"); done < <(git -C "$GREMLINS_PROJECT_ROOT" diff "$BASE_SHA...HEAD" --name-only -z)\n  fi\n  if [ ${#CHANGED_FILES[@]} -eq 0 ]; then\n    TARGET="."\n  else\n    TARGET=$(dirname "${CHANGED_FILES[0]}")\n    while true; do\n      all_under=1\n      for f in "${CHANGED_FILES[@]}"; do\n        case "$f" in\n          "$TARGET"/*) ;;\n          *) all_under=0; break ;;\n        esac\n      done\n      if [ "$all_under" -eq 1 ] || [ "$TARGET" = "." ]; then\n        break\n      fi\n      TARGET=$(dirname "$TARGET")\n    done\n  fi\n  echo "detected drag target: $TARGET"\n  printf "%s" "$TARGET" > "{target}"\nfi',
        ],
      },
    },
    // ── measure: baseline ───────────────────────────────────────────────
    {
      name: "baseline",
      type: "exec",
      interpolation: {
        inputs: {
          target: 'content("artifact://drag/target.txt")',
        },
        outputs: {
          report: "artifact://baseline/report.json",
          drag_best: "artifact://drag_best.txt",
        },
      },
      options: {
        cmds: [
          'gremlins-drag "{target}" > {report}',
          'DRAG=$(jq ".drag" {report})\nprintf "%s" "$DRAG" > {drag_best}\necho "baseline drag sum = $DRAG"',
        ],
      },
    },
    // ── drag model explanation (formula, surveys, curves) ────────────────
    {
      name: "explain",
      type: "exec",
      interpolation: {
        outputs: {
          explain: "artifact://explain.txt",
        },
      },
      options: {
        cmds: [
          'gremlins-drag --explain > {explain}',
        ],
      },
    },
    // ── plan: strategy for the single drag-reduction pass ───────────────
    {
      name: "plan",
      type: "agent",
      interpolation: {
        inputs: {
          target: 'content("artifact://drag/target.txt")',
          drag_baseline: 'content("artifact://baseline/report.json")',
          explain: 'content("artifact://explain.txt")',
          instructions: 'content("artifact://instructions.txt")',
          diff: 'content("artifact://diff.txt")?',
        },
        outputs: {
          plan: "artifact://drag/plan.md",
        },
      },
      prompt: [
        'You are planning a refactor of the target at {target} to reduce its drag score.\n\n**Your overriding goal is simple, beautiful, correct code.** Drag is the\nmetric, but genuine maintainability is the objective. The best refactorings\nare often the hardest — restructuring module boundaries, untangling\ncontrol flow, redesigning abstractions. Do not reach for the easy change\nwhen the right change is within reach. Effort spent now on quality means\nfar less maintenance burden later.\n\n## Baseline drag report\n\nThe current drag score for the target is shown below.  This is the\nstarting point — your refactoring will reduce it.\n\n<baseline_report>\n{drag_baseline}\n</baseline_report>\n\n## Drag model (how drag is computed)\n\n{explain}\n\n## How refactoring moves affect the score\n\n### token_count\nReducing a module\'s own token count directly lowers its footprint\n(since footprint includes the module itself) and may also reduce\nfootprints of upstream modules that transitively depend on it.\nSmaller total code means less surface area for bugs and lower\ncognitive load. However, token_count alone is a small part of the\ntotal drag: the comprehensibility and package-maintainability\nmultipliers can each amplify drag by up to ~12× (when m=2.5 or\np=2.5). The footprint multiplier (1+footprint)^w2 is unbounded.\n\n### footprint\nA module\'s footprint is the token sum of everything it transitively\ndepends on. Breaking deep dependency chains, inlining small\nsingle-use helpers back into their callers, and avoiding unnecessary\ncross-module couplings all reduce footprint. When a module is\nrefactored to depend on fewer other modules, its footprint\nshrinks — and every upstream module that depends on it may also\nbenefit. Footprint enters the formula as (1+footprint)^w2; larger\nfootprints amplify drag sub-linearly (w2=0.5 gives square-root\ngrowth).\n\n### comprehensibility\nComprehensibility is a multiplier on the footprint term:\nexp(m·(1−comp)). The survey dimensions and their anchors are described in the drag model above. To raise\ncomprehensibility, target the dimensions dragging a module\'s score\ndown: split dumping-ground files by concern (cohesion), break up\nmega-functions (sizing), and relocate inline tests out of the\nproduction file (test_hygiene), alongside naming, control-flow,\ndata-flow, and abstraction improvements. The effect is\nmultiplicative with footprint, so improving comprehensibility on\na high-footprint module yields more drag reduction than on a\nlow-footprint one.\n\n### package maintainability (only when `maint_score` is present)\nPackage maintainability is scored on ten dimensions (each 0–4),\nnormalized over 40 points; the dimensions and their anchors are\ndescribed in the drag model above. The package multiplier\nexp(p·(1−maint)) amplifies the sum of module drags within that\npackage; low maintainability can increase effective drag by up to\nexp(p). Improving any of the ten dimensions — extracting duplicated\nlogic into shared helpers, isolating changes to fewer files,\ntightening cross-module interfaces, flattening deep transitive\nchains, reducing public API surface, or sealing abstraction\nboundaries — raises maint_score and shrinks the package multiplier.\n\n## Splitting vs merging modules\n\nSplitting one module into two can increase or decrease total drag\ndepending on how the split affects each factor:\n\n- **token_count**: Splitting redistributes tokens across modules.\n  Total token_count across the package may stay roughly the same\n  (modulo any new imports, re-exports, or glue code).\n- **footprint**: Each half may still carry the same shared\n  transitive dependencies. If module A imports module B, A\'s\n  footprint includes B\'s tokens plus everything B depends on —\n  so splitting can increase the sum of footprints even when total\n  tokens are unchanged.\n- **comprehensibility**: Smaller, focused modules may be easier\n  to understand (raising comp). Conversely, fragmentation across\n  many files can obscure the overall design and force readers to\n  jump between files (lowering comp). The net effect depends on\n  whether the split creates clean conceptual boundaries or scatters\n  related logic.\n- **package maintainability** (when packages are present): More\n  modules may affect decomposition, change isolation, and\n  duplication scores. A split that creates clean, independent\n  boundaries can improve these dimensions. A split that scatters\n  related logic across files can hurt them. When no packages are\n  scored, this dimension does not apply.\n\nExample — splitting one module into two when both still share the\nsame transitive dependencies:\n\nOne module (2000 tokens, footprint 5000, comp 0.5, w2=0.5, m=2.5):\n  drag = (1+5000)^0.5 · exp(2.5·0.5) ≈ 70.7 · 3.49 ≈ 246.8\n\nSplit into A (1000 tokens) and B (1000 tokens), where A depends on B\nand both depend on shared downstream modules (3000 tokens beyond\nA/B themselves):\n  drag(A) = (1+5000)^0.5 · exp(2.5·0.5) ≈ 70.7 · 3.49 ≈ 246.8\n  drag(B) = (1+4000)^0.5 · exp(2.5·0.5) ≈ 63.3 · 3.49 ≈ 220.8\n  total ≈ 467.6\n\nHere splitting increased total drag because both halves still carry\nthe shared footprint. The outcome can differ when a split severs\nreal dependency edges (reducing actual transitive reach) or when\ncomprehensibility improves enough to offset the footprint penalty.\n\nMerging two modules reverses the analysis: footprint may decrease\n(fewer module-to-module edges), but comprehensibility may suffer if\nthe result is a large, unfocused file. When packages are present,\nthe net effect on package maintainability dimensions depends on\nwhether the merge consolidates related logic or creates a monolithic\nblob. When no packages are scored, this dimension does not apply.\n\n## Feature diff\n\nThe diff below shows code that was recently changed. Use it to\nunderstand what was modified and focus your refactoring on the\nnew or modified code.  When no diff is provided (empty section\nbelow), refactor the target broadly.\n\n<feature_diff>\n{diff}\n</feature_diff>\n\n## Your job\n\nWrite a high-level refactoring strategy — not a step-by-step\nimplementation guide. The implementation agent will figure out\nconcrete edits; your job is to set direction.\n\n- Identify 2–4 specific drag drivers in the baseline report\n  (high-footprint modules, low-comprehensibility modules, heavy\n  cross-module coupling, etc.).\n- For each driver, describe the **strategy** to reduce it:\n  e.g. "break the dependency chain between X and Y by inverting\n  control through a trait" or "split the 3000-token dumping-ground\n  module Z by concern into three focused modules."\n- Explain **why** each strategy should reduce drag — which term(s)\n  in the formula it affects.\n- Prioritize the strategies in the order they should be applied.\n- Keep the plan short: a few paragraphs of prose, not a long\n  checklist. The implementation agent has the full codebase and\n  will determine exact details.\n\n### What to avoid\n\n- Test reorganization as a primary strategy (tests are stripped\n  from drag scoring; `mod tests` at bottom of file is fine).\n- Cosmetic-only changes (renames, reordering, whitespace).\n- Splitting files purely to split — only split when it severs\n  real dependency edges or creates cleaner conceptual boundaries.\n\n### Principles\n\n- **Correctness and code quality above all.** Prefer changes that\n  make the code genuinely better, even when they require more work.\n- **Scope is not limited.** If the right fix restructures module\n  boundaries across several files, that is fine. Just make sure\n  it is completable in a single pass.\n\nWrite the plan to `{plan}`. Do NOT edit source files.\n\n## Additional guidance\n{instructions}\n',
      ],
      options: {
        idle_timeout: 600,
      },
    },
    // ── implement & QA: apply the plan, verify, review, and address feedback ─
    {
      name: "implement-and-qa",
      type: "implement-and-qa",
      options: {
        verify_cmds: "make -j8 check && make -j8 test",
        diff_base: "artifact://drag/drag_base_sha.txt",
        artifact_ns: "drag/",
      },
    },
    // ── measure: re-run gremlins-drag after the refactoring ─────────────
    {
      name: "after",
      type: "exec",
      interpolation: {
        inputs: {
          target: 'content("artifact://drag/target.txt")',
        },
        outputs: {
          after_report: "artifact://after-report.json",
          drag_after: "artifact://drag_after.txt",
        },
      },
      options: {
        cmds: [
          'gremlins-drag "{target}" > {after_report}',
          'DRAG=$(jq ".drag" {after_report})\nprintf "%s" "$DRAG" > {drag_after}\necho "after drag sum = $DRAG"',
        ],
      },
    },
    // ── commit message ────────────────────────────────────────────────────
    {
      name: "commit-message",
      type: "exec",
      interpolation: {
        inputs: {
          baseline_report: "artifact://baseline/report.json",
          drag_best_val: 'content("artifact://drag_best.txt")',
          drag_after_val: 'content("artifact://drag_after.txt")',
          target: 'content("artifact://drag/target.txt")',
        },
        outputs: {
          commit_message: "artifact://commit_message.txt",
        },
      },
      options: {
        cmds: [
          'BASE_SUM=$(jq ".drag" < {baseline_report})\nBEFORE="{drag_best_val}"\nAFTER="{drag_after_val}"\nTARGET="{target}"\n{\n  echo "drag-optimizer: reduce drag for $TARGET"\n  echo ""\n  echo "Baseline drag sum: $BASE_SUM"\n  echo "Drag before: $BEFORE"\n  echo "Drag after:  $AFTER"\n  echo "Target: $TARGET"\n} > {commit_message}',
        ],
      },
    },
  ],
  land: {
    interpolation: {
      inputs: {
        message: "artifact://commit_message.txt",
      },
    },
    land_cmds: [
      'WORKTREE_HEAD=$(git -C "$GREMLIN_WORKDIR" rev-parse HEAD)',
      'git merge --squash "$WORKTREE_HEAD"',
      'git diff --cached --quiet || git commit -F "{message}"',
    ],
    clean_cmds: [
      'git worktree remove --force "$GREMLIN_WORKDIR" || true',
      "git worktree prune",
    ],
  },
}
