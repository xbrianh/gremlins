{
  "required-prompt": true,
  stages: [
    {
      name: "complexity-review",
      type: "sequence",
      body: [
        {
          name: "collect",
          type: "exec",
          interpolation: {
            inputs: {
              base_sha: 'content("artifact://base_sha")',
            },
            outputs: {
              report: 'artifact://{{options.artifact_ns | default("")}}complexity-report.md',
              tree: 'artifact://{{options.artifact_ns | default("")}}complexity-report.md.tree',
              dot: 'artifact://{{options.artifact_ns | default("")}}complexity-report.md.dot',
              adjacency: 'artifact://{{options.artifact_ns | default("")}}complexity-report.md.adjacency',
            },
          },
          options: {
            timeout: 300,
            cmds: [
              'cargo_modules_report "{base_sha}" "artifact://{{options.artifact_ns | default(\"\")}}complexity-report.md" "{report}" "{tree}" "{dot}" "{adjacency}"',
            ],
          },
        },
        {
          name: "review",
          type: "agent",
          interpolation: {
            inputs: {
              plan: 'content("artifact://{{options.artifact_ns | default(\"\")}}plan.md")',
              diff: 'content("artifact://{{options.artifact_ns | default(\"\")}}diff.txt")',
              report: 'content("artifact://{{options.artifact_ns | default(\"\")}}complexity-report.md")',
            },
            outputs: {
              filepath: 'artifact://{{options.artifact_ns | default("")}}complexity-review.md',
            },
          },
          prompt: ["{{prompt}}"],
        },
      ],
    },
  ],
}