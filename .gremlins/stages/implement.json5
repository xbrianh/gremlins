{
  "flatten_into_parent": true,
  "required-prompt": true,
  stages: [
    {
      name: "implement",
      type: "agent",
      interpolation: {
        inputs: {
          plan: 'content("artifact://{{options.artifact_ns | default(\"\")}}plan.md")',
        },
      },
      prompt: ["{{prompt}}"],
      options: {
        idle_timeout: 600,
        capture_events: true,
      },
    },
    {
      name: "git-commit",
      type: "exec",
      options: {
        cmds: [
          "git add -A",
          'git diff --cached --quiet || git commit -m "implement plan"',
        ],
      },
    },
    {
      name: "require-impl-progress",
      type: "exec",
      interpolation: {
        inputs: {
          base_sha: 'content("artifact://base_sha")',
        },
      },
      options: {
        cmds: [
          'git merge-base --is-ancestor "{base_sha}" HEAD || {\n  echo "implement diverged from {base_sha}; expected fast-forward" >&2\n  exit 1\n}\n',
          'test "$(git rev-list --count "{base_sha}..HEAD")" -gt 0 || {\n  echo "implement produced no commits since {base_sha}" >&2\n  exit 1\n}\n',
        ],
      },
    },
  ],
}
