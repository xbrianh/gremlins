{
  "flatten_into_parent": true,
  "required-prompt": true,
  stages: [
    {
      name: "select-implementation-plan",
      type: "exec",
      interpolation: {
        inputs: {
          original: 'artifact://{{options.artifact_ns | default("")}}plan.md',
          retry: 'content("artifact://{prev_loop_iter}/retry-plan.md")?',
        },
        outputs: { selected: "artifact://{loop_iter}/implementation-plan.md" },
      },
      options: {
        cmds: ['if [ -n "{retry}" ]; then printf "%s\\n" "{retry}" > "{selected}"; else cp "{original}" "{selected}"; fi'],
      },
    },
    {
      // Records the tree before each attempt; `{loop_iter}` keeps judge
      // retries distinct, the namespace keeps nested callers distinct.
      name: "capture-implement-baseline",
      type: "exec",
      interpolation: {
        outputs: {
          baseline: 'artifact://{{options.artifact_ns | default("")}}{loop_iter}/implement-baseline',
        },
      },
      options: { cmds: ['tree_snapshot capture > "{baseline}"'] },
    },
    {
      name: "implement",
      type: "agent",
      interpolation: {
        inputs: {
          plan: 'content("artifact://{loop_iter}/implementation-plan.md")',
          baseline: 'content("artifact://{{options.artifact_ns | default("")}}{loop_iter}/implement-baseline")',
        },
      },
      prompt: ["{{prompt}}"],
      options: {
        done_check: 'tree_snapshot check "{baseline}"',
        idle_timeout: 600,
        capture_events: true,
      },
    },
    {
      name: "git-commit",
      type: "exec",
      options: {
        cmds: [
          "git add -A",
          'git diff --cached --quiet || git commit -m "implement plan"',
        ],
      },
    },
    {
      name: "require-impl-progress",
      type: "exec",
      interpolation: {
        inputs: {
          base_sha: 'content("artifact://base_sha")',
        },
      },
      options: {
        cmds: [
          'git merge-base --is-ancestor "{base_sha}" HEAD || {\n  echo "implement diverged from {base_sha}; expected fast-forward" >&2\n  exit 1\n}\n',
          'test "$(git rev-list --count "{base_sha}..HEAD")" -gt 0 || {\n  echo "implement produced no commits since {base_sha}" >&2\n  exit 1\n}\n',
        ],
      },
    },
  ],
}
