{
  "flatten_into_parent": true,
  "required-options": ["verify_cmds"],
  // Input contract: reads the plan written by an upstream plan stage and,
  // unless `options.diff_base` is set, the run's `artifact://base_sha`.
  // `options.artifact_ns` (optional) is a prefix applied to the plan and QA
  // artifact names so looping callers (e.g. drag-optimizer) can keep each
  // iteration's plan and review outputs distinct. It defaults to "" for the
  // non-looping local/gh pipelines. Internal outputs (`diff.txt`,
  // `review-one.md`, `review-two.md`, `complexity-review.md`,
  // `address-summary.md`) are emitted under the namespaced artifact names
  // consumed by downstream stages.
  stages: [
    // ── implement ────────────────────────────────────────────────────
    {
      name: "implement",
      type: "implement",
      options: {
        artifact_ns: '{{options.artifact_ns | default("")}}',
      },
      prompt: [
        "task-guide.md",
        "style_guide.md",
        "dev-env-howto.md",
        "implement.md",
      ],
    },
    // ── verify implementation ────────────────────────────────────────
    {
      name: "verify-implementation",
      type: "check-and-fix",
      options: {
        cmds: "{{options.verify_cmds}}",
      },
    },
    // ── compute diff ─────────────────────────────────────────────────
    {
      name: "compute-diff",
      type: "exec",
      interpolation: {
        inputs: {
          diff_base: 'content("{{options.diff_base | default(\"artifact://base_sha\")}}")',
        },
        outputs: {
          diff: 'artifact://{{options.artifact_ns | default("")}}diff.txt',
        },
      },
      options: {
        cmds: ["git diff {diff_base}...HEAD > {diff}"],
      },
    },
    // ── parallel reviews ─────────────────────────────────────────────
    {
      type: "parallel",
      fork: {
        cmds: ['git worktree add --detach "$GREMLIN_FORK_WORKDIR" HEAD'],
      },
      body: [
        {
          name: "review-one",
          type: "agent",
          interpolation: {
            inputs: {
              plan: 'content("artifact://{{options.artifact_ns | default(\"\")}}plan.md")',
              diff: 'content("artifact://{{options.artifact_ns | default(\"\")}}diff.txt")',
            },
            outputs: {
              filepath: 'artifact://{{options.artifact_ns | default("")}}review-one.md',
            },
          },
          prompt: ["review.md"],
        },
        {
          name: "review-two",
          type: "agent",
          interpolation: {
            inputs: {
              plan: 'content("artifact://{{options.artifact_ns | default(\"\")}}plan.md")',
              diff: 'content("artifact://{{options.artifact_ns | default(\"\")}}diff.txt")',
            },
            outputs: {
              filepath: 'artifact://{{options.artifact_ns | default("")}}review-two.md',
            },
          },
          prompt: ["review.md"],
        },
        {
          name: "complexity-review",
          type: "complexity-review",
          options: {
            artifact_ns: '{{options.artifact_ns | default("")}}',
          },
          prompt: ["complexity_review.md"],
        },
      ],
    },
    // ── address review feedback ──────────────────────────────────────
    {
      name: "address",
      type: "agent",
      prompt: ["style_guide.md", "dev-env-howto.md", "address.md"],
      interpolation: {
        inputs: {
          plan: 'content("artifact://{{options.artifact_ns | default(\"\")}}plan.md")',
          diff: 'content("artifact://{{options.artifact_ns | default(\"\")}}diff.txt")',
          review_one: 'content("artifact://{{options.artifact_ns | default(\"\")}}review-one.md")',
          review_two: 'content("artifact://{{options.artifact_ns | default(\"\")}}review-two.md")',
          complexity_review: 'content("artifact://{{options.artifact_ns | default(\"\")}}complexity-review.md")',
        },
        outputs: {
          address_summary: 'artifact://{{options.artifact_ns | default("")}}address-summary.md',
        },
      },
    },
    // ── verify address fixes ─────────────────────────────────────────
    {
      name: "verify-address-fixes",
      type: "check-and-fix",
      options: {
        cmds: "{{options.verify_cmds}}",
      },
    },
  ],
}