{
  prompt_dir: "prompts",
  bootstrap: {
    source: {
      require_one_of: [
        ["instructions", "plan"],
      ],
      instructions: {
        type: "string",
        optional: true,
      },
      plan: {
        type: ["filepath", "string"],
        optional: true,
      },
      base_ref: {
        type: "string",
        optional: true,
      },
    },
    launch_cmds: [
      'gremlins:bind_artifact("artifact://plan.md", plan)',
      'gremlins:bind_artifact("artifact://instructions.txt", instructions)',
      'BASE_REF={base_ref}; if [ -z "$BASE_REF" ]; then BASE_REF=$(git -C "$GREMLINS_PROJECT_ROOT" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed "s|^refs/remotes/origin/||"); [ -z "$BASE_REF" ] && BASE_REF="main"; fi; printf "%s" "$BASE_REF" > "$GREMLINS_STATE_DIR/artifacts/base_ref"',
      'SHA=$(git -C "$GREMLINS_PROJECT_ROOT" rev-parse --verify "${BASE_REF:-HEAD}") && git -C "$GREMLINS_PROJECT_ROOT" worktree add --detach "$GREMLIN_WORKDIR" "$SHA" && echo "$SHA" > "$GREMLINS_STATE_DIR/artifacts/base_sha"',
    ],
    cli_out: {
      base_sha: "artifact://base_sha",
      base_ref: "artifact://base_ref",
    },
    env: 'export GREMLINS_OPENAI_AGENTS_MAX_TURNS=\'1000\'\nexport CARGO_INCREMENTAL=0\nTHE_ENV="${GREMLINS_PROJECT_ROOT}/.gremlins/env"\nif [ -f "$THE_ENV" ]; then\n    source "$THE_ENV"\nfi\nexport PREFIX="${GREMLINS_STATE_DIR}/install"\nexport PATH="${GREMLINS_PROJECT_ROOT}/.gremlins/bin:${PATH}"\n',
  },
  land: {
    interpolation: {
      inputs: {
        pr_url: 'content("artifact://pr-url.txt")',
      },
    },
    land_cmds: [
      'gh pr merge --squash --delete-branch "{pr_url}"',
      "git fetch origin",
      "git branch -f main origin/main 2>/dev/null || git merge --ff-only origin/main",
    ],
    clean_cmds: [
      'git worktree remove --force "$GREMLIN_WORKDIR" || true',
      "git worktree prune",
    ],
  },
  "stage-definitions": {
    "plan-gh": "plan-gh",
    "github-open-pr": "github-open-pr",
    "github-request-copilot-review": "github-request-copilot-review",
    "github-wait-copilot": "github-wait-copilot",
    "github-wait-ci": "github-wait-ci",
    "github-push-to-pr-branch": "github-push-to-pr-branch",
    "check-and-fix": "check-and-fix",
  },
  stages: [
    {
      name: "plan",
      type: "plan-gh",
      prompt: ["style_guide.md", "plan_gh.md"],
    },
    {
      name: "implement-and-qa",
      type: "implement-and-qa",
      options: {
        verify_cmds: "make -j8 check && make -j8 test",
      },
    },
    {
      name: "open-pr",
      type: "github-open-pr",
    },
    {
      name: "request-copilot-review",
      type: "github-request-copilot-review",
    },
    {
      name: "wait-for-copilot",
      type: "github-wait-copilot",
    },
    {
      name: "gather-github-review-content",
      type: "exec",
      interpolation: {
        inputs: {
          pr: 'content("artifact://pr-url.txt")',
        },
        outputs: {
          github_review_content: "artifact://github-review-content.md",
        },
      },
      options: {
        cmds: ['gh_gather_review_content "{pr}" > "{github_review_content}"'],
      },
    },
    {
      name: "github-address-pull-request-reviews",
      type: "agent",
      interpolation: {
        inputs: {
          pr: 'content("artifact://pr-url.txt")',
          content: 'content("artifact://github-review-content.md")',
        },
        outputs: {
          review_summary: "artifact://review-summary.md",
        },
      },
      prompt: [
        "style_guide.md",
        "dev-env-howto.md",
        "github_address_pull_request_reviews.md",
      ],
    },
    {
      name: "verify-github-review-fixes",
      type: "check-and-fix",
      options: {
        cmds: "make -j8 check && make -j8 test",
      },
    },
    {
      name: "push-review-fixes",
      type: "github-push-to-pr-branch",
    },
    {
      name: "wait-for-ci",
      type: "github-wait-ci",
      prompt: ["style_guide.md", "dev-env-howto.md", "ci_fix.md"],
    },
  ],
}
