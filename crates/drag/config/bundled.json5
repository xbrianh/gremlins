{
  // ── Drag formula weights ──
  "weights": {
    // Weight for the footprint term: (1+footprint)^w2
    "w2": 0.5,
    // Exponent for the comprehensibility penalty: exp(m·(1−comp))
    "m": 2.5,
    // Exponent for the package maintainability penalty: exp(p·(1−maint))
    "p": 2.5
  },

  // ── Scoring parameters ──
  // Model spec for LLM scoring (null = gremlins default model).
  "model": null,
  // Tokenizer name for tiktoken-rs.
  "tokenizer": "o200k_base",
  // Number of independent LLM estimates per survey (median is used).
  "estimates_per_survey": 1,
  // Skip package-level maintainability scoring.
  "skip_maintainability": false,
  // Print diagnostic information.
  "verbose": false,
  // Output format: "human" (table) or "json".
  "format": "human",
  // Cache path (null = default under gremlins state directory).
  "cache": null,

  // ── Comprehensibility survey (module-level) ──
  "comprehensibility": {
    "preamble": "Score the above source file on comprehensibility.\n\nThe FILE SHAPE section is a structural skeleton — use it to\nassess the file's organization before reading the source.\n\nTarget reader: a competent developer familiar with the language\nbut unfamiliar with this file.  Do not assume shorter code is\nbetter or longer code is clearer.  Do not judge correctness.",

    "generic_anchors": "4: Clear on a first careful reading.\n3: Clear with minor rereading or navigation.\n2: Requires substantial tracing or inference.\n1: Important behavior is obscured.\n0: Cannot reliably understand from supplied context.",

    "dimensions": [
      {
        "key": "naming",
        "label": "naming",
        "description": "Are identifiers descriptive and consistent?"
      },
      {
        "key": "control_flow",
        "label": "control_flow",
        "description": "Can loops, branches, and early returns be followed?"
      },
      {
        "key": "data_flow",
        "label": "data_flow",
        "description": "Can data movement through the module be traced?"
      },
      {
        "key": "abstractions",
        "label": "abstractions",
        "description": "Are interfaces, types, and layers well-chosen?"
      },
      {
        "key": "cohesion",
        "label": "cohesion",
        "description": "Does the file have one clear responsibility, or is it a dumping ground?"
      },
      {
        "key": "sizing",
        "label": "sizing",
        "description": "Are functions/types well-sized, or are there mega-functions with huge parameter lists?"
      },
      {
        "key": "test_hygiene",
        "label": "test_hygiene",
        "description": "Are tests inline and dominant, or cleanly separated from production code?"
      }
    ],

    // Structural dimension anchors — only dimensions listed here get
    // extra anchoring text in the prompt.
    "structural_anchors": {
      "cohesion": "0=dumping ground (5+ unrelated concerns), 1=3-4 concerns with informal boundaries,\n2=2-3 concerns with one dominant, 3=primary responsibility + minor secondary,\n4=single crystal-clear responsibility.",
      "sizing": "0=multiple 200+ line functions, 1=at least one 150+ line function,\n2=mostly reasonable with 1-2 outliers, 3=consistently well-sized (max ~60-80 lines),\n4=every function fits on screen, minimal params, state in context structs.",
      "test_hygiene": "0=tests >50% of file inline, 1=30-50% inline,\n2=<30% inline, 3=cleanly separated at bottom in single test module,\n4=tests in dedicated test files, zero test code in production file."
    }
  },

  // ── Maintainability survey (package-level) ──
  "maintainability": {
    "preamble": "Target audience: an experienced developer evaluating whether the package is well-organized for long-term maintenance. Judge the package's structure — not correctness, not performance.\n\nScore this single dimension on a 0–4 scale using these anchors:",

    "dimensions": [
      {
        "key": "decomposition",
        "label": "decomposition",
        "description": "Decomposition: Are modules appropriately sized and focused? Does each module have a clear, singular responsibility?",
        "anchors": "0: Nearly every module is a dumping ground — files mix unrelated concerns and responsibilities are scattered.\n1: Some modules have a clear focus, but several are overloaded or split arbitrarily.\n2: Most modules have a discernible responsibility, though a few could be split or merged.\n3: Modules are focused and responsibilities are clearly separated; minor boundary adjustments possible.\n4: Every module has a single, well-chosen responsibility; the decomposition would serve as a model for other packages."
      },
      {
        "key": "interface_design",
        "label": "interface design",
        "description": "Interface design: Are cross-module contracts minimal and clear? Are public APIs narrow and well-defined?",
        "anchors": "0: Public APIs expose internal details indiscriminately; modules expose dozens of unrelated items.\n1: Some modules have reasonable public surfaces, but several are bloated or leaky.\n2: Most public APIs are reasonably narrow; a few modules expose more than necessary.\n3: Public APIs are consistently narrow and well-chosen; imports are mostly what you'd expect.\n4: Every public item is intentionally exposed; the API surface is minimal, coherent, and discoverable."
      },
      {
        "key": "consistency",
        "label": "consistency",
        "description": "Consistency: Do naming, error handling, and abstraction levels stay uniform across the package?",
        "anchors": "0: Naming conventions, error strategies, and abstraction levels vary wildly across files.\n1: Some patterns are repeated, but the package feels like it was written by several teams with different conventions.\n2: Conventions are mostly followed; a few outliers exist but don't dominate.\n3: The package reads uniformly; naming, error handling, and abstraction levels are consistent with only minor deviations.\n4: The entire package feels like a single author wrote it with a clear style guide; consistency is exemplary."
      },
      {
        "key": "change_isolation",
        "label": "change isolation",
        "description": "Change isolation: Would a typical feature change touch one module or scatter across many?",
        "anchors": "0: Any non-trivial change ripples across most of the package; modules are tightly coupled.\n1: Some changes are local, but many require coordinated edits across several files.\n2: Most feature changes touch 1–2 modules; cross-cutting changes are the exception.\n3: Modules are well-isolated; typical changes are confined to a single module with rare cross-module impact.\n4: The package is organized so that every likely change is local to one module; coupling is minimal and intentional."
      },
      {
        "key": "duplication",
        "label": "duplication",
        "description": "Code duplication: Are repeated blocks of logic extracted into shared helpers? Is copy-paste minimal across the package?",
        "anchors": "0: Substantial copy-paste across files; the same logic appears verbatim in 3+ places.\n1: Several duplicated blocks exist; some could be extracted but aren't.\n2: Occasional duplication where extraction would add more indirection than value; mostly DRY.\n3: Very little duplication; shared logic is extracted into appropriate helpers or base types.\n4: No meaningful duplication anywhere; every piece of logic has a single canonical home."
      },
      {
        "key": "locality",
        "label": "locality",
        "description": "Locality: Can a developer understand what a module does by reading it and its direct dependencies, or does understanding require tracing deep transitive chains across the package?",
        "anchors": "0: Every module transitively imports 80%+ of the package; nothing can be understood in isolation.\n1: Many modules have deep transitive dependency chains; understanding one requires tracing through half the package.\n2: Most modules can be understood from their direct deps plus 1–2 levels of transitive deps.\n3: Modules are mostly understandable from their direct dependencies alone; transitive knowledge is rarely needed.\n4: Every module is understandable from its direct dependencies alone; the dependency graph is shallow and clear."
      },
      {
        "key": "abstraction_clarity",
        "label": "abstraction clarity",
        "description": "Abstraction clarity: When reading the code, is the core intent immediately visible, or is it buried under layers of indirection, framework machinery, and cross-cutting concerns?",
        "anchors": "0: The core logic is buried under so many layers of indirection that the reader cannot discern what the code actually does.\n1: Heavy use of indirection; the reader must untangle several layers to find the essential logic.\n2: Some indirection exists, but the main flow is discernible with moderate effort.\n3: Abstractions are mostly helpful; the core intent is clear after a quick skim.\n4: Abstractions reveal rather than hide intent; the code reads like a well-written narrative."
      },
      {
        "key": "conceptual_surface",
        "label": "conceptual surface area",
        "description": "Conceptual surface area: Is the package's public API surface small, focused, and easy to internalize? Or does it expose so many distinct types, traits, functions, and behavioral modes that a developer cannot make changes confidently?",
        "anchors": "0: The surface area is enormous — hundreds of public items with subtle interactions; no one can hold it in their head.\n1: The surface is large and several concepts interact in surprising ways; developers must consult docs constantly.\n2: The surface is manageable; most concepts are straightforward, with a few complex interactions.\n3: The surface is small and well-documented; a developer can internalize it quickly.\n4: The surface is minimal, orthogonal, and instantly grokkable; every public concept pulls its weight."
      },
      {
        "key": "predictability",
        "label": "predictability",
        "description": "Predictability: Does the code behave the way its names and public API suggest, or are there hidden behaviors, implicit invariants, and surprising edge cases?",
        "anchors": "0: Names and signatures are actively misleading; behavior contradicts what any reasonable developer would expect.\n1: Several functions have hidden side effects or surprising invariants that are not documented.\n2: Most behavior is predictable; a few edge cases or implicit assumptions exist.\n3: Names and signatures accurately describe behavior; surprises are rare and well-documented.\n4: The code is entirely predictable from its public API; a developer's mental model will never be wrong."
      },
      {
        "key": "evasion",
        "label": "evasion",
        "description": "Evasion: Does the implementation respect its own abstraction boundaries, so that each layer can be understood independently? Or does it reach behind interfaces, punch through layers, and otherwise break separations of concern?",
        "anchors": "0: Abstraction boundaries are routinely violated; internal details of other modules are accessed directly throughout.\n1: Several violations exist where code reaches behind interfaces or bypasses intended access patterns.\n2: Most boundaries are respected; a few pragmatic violations exist but are contained.\n3: Abstraction boundaries are consistently honored; layers are cleanly separated.\n4: Every abstraction boundary is airtight; each layer can be understood, tested, and modified independently."
      }
    ]
  }
}